<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="autopilot_sale_order_file_view_list" model="ir.ui.view">
        <field name="name">autopilot_sale.order.file.list</field>
        <field name="model">autopilot_sale.order.file</field>
        <field name="arch" type="xml">
            <list
                string="Sale EDI Order Files"
                decoration-danger="state == 'failed'"
                decoration-muted="state in ('done', 'cancelled')"
            >
                <field name="backend_id" />
                <field name="filename" />
                <field name="source" />
                <field name="path" optional="hide" />
                <field name="state" />
                <field name="error" />
                <field name="order_count" />
                <button
                    name="action_retry"
                    type="object"
                    string="Retry"
                    icon="fa-refresh"
                    invisible="state not in ('failed', 'cancelled')"
                    groups="sales_team.group_sale_manager"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="Cancel"
                    icon="fa-times"
                    invisible="state not in ('pending', 'failed')"
                    groups="sales_team.group_sale_manager"
                />
            </list>
        </field>
    </record>

    <record id="autopilot_sale_order_file_view_form" model="ir.ui.view">
        <field name="name">autopilot_sale.order.file.form</field>
        <field name="model">autopilot_sale.order.file</field>
        <field name="arch" type="xml">
            <form string="Sale EDI Order File">
                <header>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        invisible="state not in ('failed', 'cancelled')"
                        groups="sales_team.group_sale_manager"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('pending', 'failed')"
                        groups="sales_team.group_sale_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                        >
                            <field
                                name="order_count"
                                widget="statinfo"
                                string="Orders"
                            />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="source" />
                            <field name="path" invisible="not path" />
                            <field name="filename" invisible="1" />
                            <field name="data" filename="filename" />
                        </group>
                        <group>
                            <field name="error" />
                        </group>
                    </group>
                    <group string="Error Detail" invisible="not error_detail">
                        <field name="error_detail" nolabel="1" widget="text" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="autopilot_sale_order_file_view_search" model="ir.ui.view">
        <field name="name">autopilot_sale.order.file.search</field>
        <field name="model">autopilot_sale.order.file</field>
        <field name="arch" type="xml">
            <search string="Sale EDI Order Files">
                <field name="backend_id" />
                <field name="filename" />
                <field name="path" />
                <filter
                    name="uploaded"
                    string="Uploaded"
                    domain="[('source', '=', 'upload')]"
                />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <group>
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="autopilot_sale_order_view_list" model="ir.ui.view">
        <field name="name">autopilot_sale.order.list</field>
        <field name="model">autopilot_sale.order</field>
        <field name="arch" type="xml">
            <list
                string="Sale EDI Orders"
                decoration-danger="state == 'failed'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="display_name" />
                <field name="backend_id" />
                <field name="odoo_id" />
                <field name="file_id" />
                <field name="external_ref" />
                <field name="state" />
                <field name="error" optional="show" />
                <button
                    name="action_retry"
                    type="object"
                    string="Retry"
                    icon="fa-refresh"
                    invisible="state not in ('failed', 'cancelled')"
                    groups="sales_team.group_sale_manager"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="Cancel"
                    icon="fa-times"
                    invisible="state not in ('pending', 'failed')"
                    groups="sales_team.group_sale_manager"
                />
            </list>
        </field>
    </record>

    <record id="autopilot_sale_order_view_form" model="ir.ui.view">
        <field name="name">autopilot_sale.order.form</field>
        <field name="model">autopilot_sale.order</field>
        <field name="arch" type="xml">
            <form string="Sale EDI Order">
                <header>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        invisible="state not in ('failed', 'cancelled')"
                        groups="sales_team.group_sale_manager"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('pending', 'failed')"
                        groups="sales_team.group_sale_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,done"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="odoo_id" />
                            <field name="file_id" />
                        </group>
                        <group>
                            <field name="external_ref" />
                            <field name="error" invisible="not error" />
                            <field name="payload" filename="external_ref" />
                        </group>
                    </group>
                    <group string="Error Detail" invisible="not error_detail">
                        <field name="error_detail" nolabel="1" widget="text" />
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="odoo_id" />
                                    <field name="external_ref" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="autopilot_sale_order_view_search" model="ir.ui.view">
        <field name="name">autopilot_sale.order.search</field>
        <field name="model">autopilot_sale.order</field>
        <field name="arch" type="xml">
            <search string="Sale EDI Orders">
                <field name="external_ref" />
                <field name="odoo_id" />
                <field name="backend_id" />
                <field name="file_id" />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <group>
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="autopilot_sale_picking_view_list" model="ir.ui.view">
        <field name="name">autopilot_sale.picking.list</field>
        <field name="model">autopilot_sale.picking</field>
        <field name="arch" type="xml">
            <list string="Sale EDI Dispatch Notes">
                <field name="display_name" />
                <field name="backend_id" />
                <field name="odoo_id" />
                <field name="sent_date" />
            </list>
        </field>
    </record>

    <record id="autopilot_sale_picking_view_form" model="ir.ui.view">
        <field name="name">autopilot_sale.picking.form</field>
        <field name="model">autopilot_sale.picking</field>
        <field name="arch" type="xml">
            <form string="Sale EDI Dispatch Note">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="odoo_id" />
                        </group>
                        <group>
                            <field name="sent_date" />
                            <field name="attachment_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="autopilot_sale_invoice_view_list" model="ir.ui.view">
        <field name="name">autopilot_sale.invoice.list</field>
        <field name="model">autopilot_sale.invoice</field>
        <field name="arch" type="xml">
            <list string="Sale EDI Invoices">
                <field name="display_name" />
                <field name="backend_id" />
                <field name="odoo_id" />
                <field name="sent_date" />
            </list>
        </field>
    </record>

    <record id="autopilot_sale_invoice_view_form" model="ir.ui.view">
        <field name="name">autopilot_sale.invoice.form</field>
        <field name="model">autopilot_sale.invoice</field>
        <field name="arch" type="xml">
            <form string="Sale EDI Invoice">
                <sheet>
                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="odoo_id" />
                        </group>
                        <group>
                            <field name="sent_date" />
                            <field name="attachment_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</odoo>
