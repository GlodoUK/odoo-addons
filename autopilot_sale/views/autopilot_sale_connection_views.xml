<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- The shared connection form (autopilot), with this module's own
         access. -->
    <record id="autopilot_sale_connection_view_form" model="ir.ui.view">
        <field name="name">autopilot_sale.connection.form</field>
        <field name="model">autopilot_sale.connection</field>
        <field name="inherit_id" ref="autopilot.autopilot_fsspec_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced']" position="attributes">
                <attribute
                    name="groups"
                >base.group_system,sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="autopilot_sale_connection_view_list" model="ir.ui.view">
        <field name="name">autopilot_sale.connection.list</field>
        <field name="model">autopilot_sale.connection</field>
        <field name="arch" type="xml">
            <list string="Sale EDI Connections">
                <field name="name" />
                <field name="protocol" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="autopilot_sale_connection_view_search" model="ir.ui.view">
        <field name="name">autopilot_sale.connection.search</field>
        <field name="model">autopilot_sale.connection</field>
        <field name="arch" type="xml">
            <search string="Sale EDI Connections">
                <field name="name" />
                <field name="protocol" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_autopilot_sale_connection" model="ir.actions.act_window">
        <field name="name">Sale EDI Connections</field>
        <field name="res_model">autopilot_sale.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_autopilot_sale_connection"
        name="Connections"
        parent="menu_autopilot_sale"
        action="action_autopilot_sale_connection"
        groups="sales_team.group_sale_manager"
        sequence="20"
    />
</odoo>
