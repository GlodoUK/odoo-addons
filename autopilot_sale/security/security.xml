<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rule_autopilot_sale_backend_company" model="ir.rule">
        <field name="name">Sale EDI Backend: multi-company</field>
        <field name="model_id" ref="model_autopilot_sale_backend" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_sale_order_company" model="ir.rule">
        <field name="name">Sale EDI Order Binding: multi-company</field>
        <field name="model_id" ref="model_autopilot_sale_order" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_sale_order_line_company" model="ir.rule">
        <field name="name">Sale EDI Order Line Binding: multi-company</field>
        <field name="model_id" ref="model_autopilot_sale_order_line" />
        <field
            name="domain_force"
        >['|', ('backend_id.company_id', '=', False), ('backend_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_sale_picking_company" model="ir.rule">
        <field name="name">Sale EDI Dispatch Note Binding: multi-company</field>
        <field name="model_id" ref="model_autopilot_sale_picking" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_sale_invoice_company" model="ir.rule">
        <field name="name">Sale EDI Invoice Binding: multi-company</field>
        <field name="model_id" ref="model_autopilot_sale_invoice" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!--
      Access-group restriction. Global rules (no group_id), so they apply to
      every user and AND with the multi-company rules above. A backend with no
      restrict_group_ids is visible to anyone the ACLs allow; otherwise the user
      must belong (directly or by implication) to one of the listed groups. The
      binding rules ride the backend's restriction so it can't be side-stepped.
    -->
    <record id="rule_autopilot_sale_backend_access" model="ir.rule">
        <field name="name">Sale EDI Backend: access groups</field>
        <field name="model_id" ref="model_autopilot_sale_backend" />
        <field
            name="domain_force"
        >['|', ('restrict_group_ids', '=', False), ('restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_sale_order_access" model="ir.rule">
        <field name="name">Sale EDI Order Binding: access groups</field>
        <field name="model_id" ref="model_autopilot_sale_order" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_sale_order_line_access" model="ir.rule">
        <field name="name">Sale EDI Order Line Binding: access groups</field>
        <field name="model_id" ref="model_autopilot_sale_order_line" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_sale_picking_access" model="ir.rule">
        <field name="name">Sale EDI Dispatch Note Binding: access groups</field>
        <field name="model_id" ref="model_autopilot_sale_picking" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_sale_invoice_access" model="ir.rule">
        <field name="name">Sale EDI Invoice Binding: access groups</field>
        <field name="model_id" ref="model_autopilot_sale_invoice" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>
</odoo>
