<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_edi_messages"
                    icon="fa-envelope-open-o"
                    invisible="not edi_message_count"
                >
                    <field string="EDI Messages" name="edi_message_count" widget="statinfo" />
                </button>
            </div>

            <xpath expr="//notebook" position="inside">
                <page name="edi_product_ids" string="EDI" invisible="not edi_product_count" />
                    <group>
                        <field name="edi_product_tmpl_ids" nolabel="1">
                            <list create="false">
                                <field name="edi_message_id" widget="many2one" />
                                <field name="edi_external_id" />
                                <field name="backend_id" widget="many2one" />
                            </list>
                        </field>

                        <field name="edi_product_ids" nolabel="1">
                            <list create="false">
                                <field name="edi_message_id" widget="many2one" />
                                <field name="edi_external_id" />
                                <field name="backend_id" widget="many2one" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
