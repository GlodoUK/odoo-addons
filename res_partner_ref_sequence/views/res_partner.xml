<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.ref.sequence</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='sales_purchases']//field[@name='ref']"
                position="replace"
            >
                <label for="ref" string="Reference" />
                <div class="o_row">
                    <field name="ref" string="Reference" nolabel="1" />
                    <button
                        name="action_generate_ref"
                        type="object"
                        string="Generate"
                        class="btn-link px-0"
                        invisible="not is_company or ref"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
