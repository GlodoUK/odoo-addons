<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_ref_sequence_rule_view_list" model="ir.ui.view">
        <field name="name">res_partner_ref_sequence.rule.list</field>
        <field name="model">res_partner_ref_sequence.rule</field>
        <field name="arch" type="xml">
            <list string="Partner Reference Rules">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="domain" />
                <field name="sequence_id" />
            </list>
        </field>
    </record>

    <record id="res_partner_ref_sequence_rule_view_form" model="ir.ui.view">
        <field name="name">res_partner_ref_sequence.rule.form</field>
        <field name="model">res_partner_ref_sequence.rule</field>
        <field name="arch" type="xml">
            <form string="Partner Reference Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Suppliers" />
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1" />
                        <field name="sequence" />
                        <field name="sequence_id" options="{'no_quick_create': True}" />
                    </group>
                    <group string="Applies To">
                        <field
                            name="domain"
                            widget="domain"
                            options="{'model': 'res.partner'}"
                            nolabel="1"
                            colspan="2"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_ref_sequence_rule_action" model="ir.actions.act_window">
        <field name="name">Partner Reference Rules</field>
        <field name="res_model">res_partner_ref_sequence.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a partner reference rule</p>
            <p
            >The first rule matching a company decides which sequence its reference is taken from.</p>
        </field>
    </record>

    <menuitem
        id="res_partner_ref_sequence_rule_menu"
        name="Reference Rules"
        action="res_partner_ref_sequence_rule_action"
        parent="contacts.res_partner_menu_config"
        sequence="3"
    />
</odoo>
