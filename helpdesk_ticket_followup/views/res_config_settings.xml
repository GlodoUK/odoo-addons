<odoo>
   <record id="followup_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">followup.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="after">
                <h2>Helpdesk ticket followup</h2>
                <div class="row mt16 o_settings_container" id="ticket_followup">
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="ticket_followup_first"
                    >
                        <div class="o_setting_left_pane">
                            <field name="glo_is_send_1st_followup" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="glo_is_send_1st_followup" /><br />
                            <span
                                attrs="{'invisible':[('glo_is_send_1st_followup','=',False)]}"
                            >
                                in <field name="glo_1st_followup_hrs" /> hrs
                            </span>
                            <div class="text-muted">
                                When user does not respond to our message - send first followup email
                            </div>
                        </div>
                    </div>
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="ticket_followup_second"
                    >
                        <div class="o_setting_left_pane">
                            <field name="glo_is_send_2nd_followup" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="glo_is_send_2nd_followup" /><br />
                            <span
                                attrs="{'invisible':[('glo_is_send_2nd_followup','=',False)]}"
                            >
                                in <field name="glo_2nd_followup_hrs" /> hrs
                            </span>
                            <div class="text-muted">
                                When user does not respond to our message - send second followup email
                            </div>
                        </div>
                    </div>
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="ticket_followup_auto"
                    >
                        <div class="o_setting_left_pane">
                            <field name="glo_is_close_automatically" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="glo_is_close_automatically" /><br />
                            <span
                                attrs="{'invisible':[('glo_is_close_automatically','=',False)]}"
                            >
                                in <field name="glo_close_automatically_hrs" /> hrs
                            </span>
                            <div class="text-muted">
                                Automatically close ticket if cliend did not respond
                            </div>
                        </div>
                    </div>
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="ticket_followup_user_mod"
                    >
                        <div class="o_setting_left_pane">
                            <field name="glo_is_user_followup_mod" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="glo_is_user_followup_mod" /><br />
                            <div class="text-muted">
                                Allow user turn off/snooze followup email notifications
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
