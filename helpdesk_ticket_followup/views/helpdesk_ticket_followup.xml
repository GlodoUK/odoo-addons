<odoo>
    <record
        model="ir.ui.view"
        id="helpdesk_ticket_followup_helpdesk_ticket_followup_tree"
    >
        <field name="name">Ticket followup</field>
        <field name="model">helpdesk.ticket.followup</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="date_start" />
                <field name="helpdesk_ticket_id" />
                <field name="is_1st_sent" />
                <field name="is_2nd_sent" />
            </tree>
        </field>
    </record>

    <record
        id="helpdesk_ticket_followup_helpdesk_ticket_followup_act"
        model="ir.actions.act_window"
    >
        <field name="name">Ticket followup</field>
        <field name="res_model">helpdesk.ticket.followup</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new ticket followup
            </p>
        </field>
    </record>
    <menuitem
        id="helpdesk_ticket_followup_menu_helpdesk_ticket_followup"
        name="Ticket followup"
        parent="helpdesk.helpdesk_menu_config"
        action="helpdesk_ticket_followup_helpdesk_ticket_followup_act"
    />
</odoo>
