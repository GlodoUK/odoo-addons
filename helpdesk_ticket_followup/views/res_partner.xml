<odoo>
    <record id="helpdesk_ticket_followup_view_partner_form" model="ir.ui.view">
        <field name="name">helpdesk_ticket_followup_view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Helpdesk Followup" name="helpdesk_followup">
                    <group>
                        <group>
                            <field name="snooze_till_date" widget="date" />
                            <field name="is_send_followup_1st" />
                            <field name="is_send_followup_2nd" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
