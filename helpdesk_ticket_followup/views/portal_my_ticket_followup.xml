<odoo>
    <template
        id="helpdesk_ticket_followup_my_ticket_followup_link"
        name="Link to frontend portal ticket followup"
        inherit_id="portal.user_dropdown"
    >
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <t t-if="is_user_followup_mod">
                <a
                    href="/my/followup_settings"
                    role="menuitem"
                    class="dropdown-item"
                >Followup Settings</a>
            </t>
        </xpath>
    </template>

    <template
        id="helpdesk_ticket_followup_ticket_followup_settings_page"
        name="Ticket Followup Settings Page"
    >
        <t t-call="portal.portal_layout">
            <div class="card-body px-5">
                <div class="row d-flex justify-content-center mb-2">
                    <h2>
                        Followup Settings
                    </h2>
                </div>
                <div class="row">
                    <form method="POST">
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <div class="form-row">
                            <h3>
                                Snooze notifications till
                            </h3>
                        </div>
                        <div class="input-group date mb-2">
                            <input
                                class="form-control"
                                type="date"
                                id="snooze_till_date"
                                name="snooze_till_date"
                                t-att-value="snooze_till_date"
                            />
                            <span class="input-group-append">
                                <span class="input-group-text bg-light d-block">
                                    <i class="fa fa-calendar" />
                                </span>
                            </span>
                        </div>
                        <div class="form-row">
                            <t
                                t-if="glo_1st_followup_hrs or glo_2nd_followup_hrs or glo_close_automatically_hrs"
                            >
                                <h3>
                                    Notifications
                                </h3>
                            </t>
                        </div>
                        <div class="form-row mb-2">
                            <b><i>
                                <t t-if="glo_close_automatically_hrs">
                                    Your ticket will be automatically closed in <t
                                            t-esc="glo_close_automatically_hrs"
                                        /> hours.<br />
                                </t>
                                <t t-if="glo_1st_followup_hrs or glo_2nd_followup_hrs">
                                    You can receive reminding emails:
                                </t>
                            </i></b>
                        </div>
                        <t t-if="glo_1st_followup_hrs">
                            <div class="form-check">
                                <input
                                    id="followup_1st"
                                    name="followup_1st"
                                    class="form-check-input"
                                    type="checkbox"
                                    t-att-checked="cur_partner_id.is_send_followup_1st"
                                />
                                <label class="form-check-label" for="followup_1st">
                                    Send reminding followup email in <t
                                        t-esc="glo_1st_followup_hrs"
                                    /> hours
                                </label>
                            </div>
                        </t>
                        <t t-if="glo_2nd_followup_hrs">
                            <div class="form-check">
                                <input
                                    id="followup_2nd"
                                    name="followup_2nd"
                                    class="form-check-input"
                                    type="checkbox"
                                    t-att-checked="cur_partner_id.is_send_followup_2nd"
                                />
                                <label class="form-check-label" for="followup_2nd">
                                    Send reminding followup email in <t
                                        t-esc="glo_2nd_followup_hrs"
                                    /> hours
                                </label>
                            </div>
                        </t>
                        <div class="form-row">
                            <button type="submit" class="btn btn-primary btn-lg m-2">
                                <b>
                                    Update
                                </b>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
