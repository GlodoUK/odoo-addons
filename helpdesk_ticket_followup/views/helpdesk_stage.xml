<odoo>
    <record id="helpdesk_ticket_followup_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">helpdesk_ticket_followup_helpdesk_stage_form</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="glo_stage_type" />
                <field
                    name="glo_followup_mail_temp_1st"
                    attrs="{'invisible': [('glo_stage_type', '!=', 'customer_update')]}"
                />
                <field
                    name="glo_followup_mail_temp_2nd"
                    attrs="{'invisible': [('glo_stage_type', '!=', 'customer_update')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
