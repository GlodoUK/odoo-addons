    <record id="helpdesk_stage_customer_update" model="helpdesk.stage">
        <field name="name">Customer Update</field>
        <field name="glo_stage_type">customer_update</field>
        <field name="sequence">1</field>
    </record>
    <record id="helpdesk_stage_done" model="helpdesk.stage">
        <field name="name">Done</field>
        <field name="sequence">2</field>
        <field name="template_id" ref="helpdesk.rating_ticket_request_email_template" />
        <field name="is_close" eval="True" />
        <field name="fold" eval="True" />
        <field name="glo_stage_type">closed</field>
    </record>
</odoo>
