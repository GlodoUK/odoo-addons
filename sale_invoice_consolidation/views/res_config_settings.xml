<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.sale.invoice.consolidation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!--
                Accounting/Invoicing settings have no Consolidation section, so
                add one after Customer Invoices for this module's settings.
            -->
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Consolidation" id="sale_invoice_consolidation_settings">
                    <setting
                        id="sale_auto_invoice_credit_notes_setting"
                        help="Let the automatic invoicing run raise credit notes for pending negative quantities, such as returns or downward corrections. When off, only positive quantities are invoiced automatically."
                    >
                        <field name="sale_auto_invoice_credit_notes" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
