<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.email.domain</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page
                    name="email_domains"
                    string="Email Domains"
                    invisible="not is_company"
                >
                    <field name="email_domain_ids" groups="base.group_partner_manager">
                        <list editable="bottom">
                            <field name="name" placeholder="e.g. example.com" />
                            <field name="domain_normalized" optional="hide" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
