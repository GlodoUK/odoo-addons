<odoo>
    <record id="view_website_form" model="ir.ui.view">
        <field name="name">view_website_form</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="ecommerce_requires_login" widget="boolean_toggle" />
                <field
                    name="ecommerce_requires_login_status_code"
                    invisible="not ecommerce_requires_login"
                />
            </xpath>
        </field>
    </record>
</odoo>
