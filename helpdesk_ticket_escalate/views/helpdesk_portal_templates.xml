<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="portal_helpdesk_ticket" inherit_id="helpdesk.portal_helpdesk_ticket">
        <xpath expr="//t[@t-foreach='tickets']/tr/td[1]" position="inside">
            <span
                class="badge text-bg-warning"
                t-if="ticket.is_escalated"
            >Escalated</span>
        </xpath>
    </template>
    <template id="tickets_followup" inherit_id="helpdesk.tickets_followup">
        <xpath expr="//t[@t-set='entries']/ul" position="inside">
            <li class="list-group-item flex-grow-1 d-flex flex-wrap align-items-center">
                <strong class="d-block w-100">Priority</strong>
                <t
                    t-out="dict(ticket._fields['priority'].selection).get(ticket.priority)"
                />

                <p class="text-warning w-100 fw-bold" t-if="ticket.is_escalated">
                    Marked for escalation
                </p>

                <t t-if="not ticket.is_escalated">
                <button
                        class="ms-auto btn btn-light"
                        data-bs-target="#helpdesk_ticket_escalate_modal"
                        data-bs-toggle="modal"
                    >
                    <i class="fa fa-danger" />
                    Escalate Ticket
                </button>

            <div
                        class="modal"
                        tabindex="-1"
                        role="dialog"
                        id="helpdesk_ticket_escalate_modal"
                    >
                <div class="modal-dialog mt-5" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Ticket Escalation</h5>
                            <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    />
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you wish to proceed?</p>
                        </div>
                        <div class="modal-footer">
                            <a
                                        role="button"
                                        class="btn btn-primary"
                                        t-att-href="'/helpdesk/ticket/' + str(ticket.id) + '/escalate'"
                                    >Toggle Escalation</a>
                            <button
                                        type="button"
                                        class="btn btn-light"
                                        data-bs-dismiss="modal"
                                    >Close</button>
                        </div>
                    </div>
                </div>
            </div></t>
            </li>
        </xpath>
    </template>
</odoo>
