<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="consolidation_package_capacity_view_list" model="ir.ui.view">
        <field name="name">consolidation.package.capacity.list</field>
        <field name="model">consolidation.package.capacity</field>
        <field name="arch" type="xml">
            <list string="Package Capacities" editable="bottom">
                <field name="product_id" />
                <field name="package_type_id" />
                <field name="max_qty" />
                <field name="uom_id" groups="uom.group_uom" />
            </list>
        </field>
    </record>

    <record id="consolidation_package_capacity_view_form" model="ir.ui.view">
        <field name="name">consolidation.package.capacity.form</field>
        <field name="model">consolidation.package.capacity</field>
        <field name="arch" type="xml">
            <form string="Package Capacity">
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="package_type_id" />
                        <field name="max_qty" />
                        <field name="uom_id" groups="uom.group_uom" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="consolidation_package_capacity_view_search" model="ir.ui.view">
        <field name="name">consolidation.package.capacity.search</field>
        <field name="model">consolidation.package.capacity</field>
        <field name="arch" type="xml">
            <search string="Package Capacities">
                <field name="product_id" />
                <field name="package_type_id" />
                <group>
                    <filter
                        name="group_package_type"
                        string="Package Type"
                        context="{'group_by': 'package_type_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="consolidation_package_capacity_action" model="ir.actions.act_window">
        <field name="name">Package Capacities</field>
        <field name="res_model">consolidation.package.capacity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how much of a product fits on a single package
            </p>
            <p>
                Capacities drive the real-time package fill level and decide which
                packages can be merged together.
            </p>
        </field>
    </record>
</odoo>
