<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_package_view_form" model="ir.ui.view">
        <field name="name">stock.package.form.package</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pack_date']" position="after">
                <field name="can_be_consolidated" invisible="1" />
                <field name="package_product_id" invisible="not can_be_consolidated" />
                <field name="capacity_qty" invisible="not can_be_consolidated" />
                <field name="content_qty" invisible="not can_be_consolidated" />
                <field name="reserved_qty" invisible="not can_be_consolidated" />
                <field name="remaining_qty" invisible="not can_be_consolidated" />
                <field
                    name="fill_pct"
                    widget="progressbar"
                    invisible="not can_be_consolidated"
                />
            </xpath>
        </field>
    </record>

    <record id="stock_package_view_list" model="ir.ui.view">
        <field name="name">stock.package.list.package</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_list" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="package_product_id" optional="show" />
                <field name="content_qty" optional="show" />
                <field name="capacity_qty" optional="show" />
                <field name="fill_pct" widget="progressbar" optional="show" />
            </field>
        </field>
    </record>

    <record id="stock_package_view_search" model="ir.ui.view">
        <field name="name">stock.package.search.package</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="can_be_consolidated"
                    string="Can Be Consolidated"
                    domain="[('can_be_consolidated', '=', True)]"
                />
                <group>
                    <filter
                        name="group_product"
                        string="Product"
                        context="{'group_by': 'package_product_id'}"
                    />
                    <filter
                        name="group_location"
                        string="Location"
                        context="{'group_by': 'location_id'}"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <record id="package_action" model="ir.actions.act_window">
        <field name="name">Consolidatable Packages</field>
        <field name="res_model">stock.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('can_be_consolidated', '=', True)]</field>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing to consolidate
            </p>
            <p>
                Packages flagged as consolidatable appear here with their real-time fill level.
            </p>
        </field>
    </record>
</odoo>
