<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="autopilot_activity_view_list" model="ir.ui.view">
        <field name="name">autopilot.activity.list</field>
        <field name="model">autopilot.activity</field>
        <field name="arch" type="xml">
            <list
                string="Activity"
                action="action_open"
                type="object"
                create="0"
                edit="0"
                delete="0"
                decoration-danger="status == 'error'"
                decoration-info="status in ('draft', 'pending')"
                decoration-muted="status in ('done', 'cancelled')"
            >
                <field name="date" />
                <field name="res_model" />
                <field name="name" />
                <field name="backend" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state_label" />
                <field name="status" widget="badge" />
                <field name="error" optional="show" />
                <field name="can_retry" column_invisible="1" />
                <field name="can_cancel" column_invisible="1" />
                <button
                    name="action_retry"
                    type="object"
                    string="Retry"
                    icon="fa-refresh"
                    invisible="not can_retry"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="Cancel"
                    icon="fa-times"
                    invisible="not can_cancel"
                />
            </list>
        </field>
    </record>

    <record id="autopilot_activity_view_search" model="ir.ui.view">
        <field name="name">autopilot.activity.search</field>
        <field name="model">autopilot.activity</field>
        <field name="arch" type="xml">
            <search string="Activity">
                <field name="res_model" />
                <field name="error" />
                <filter
                    name="error"
                    string="Error"
                    domain="[('status', '=', 'error')]"
                />
                <filter
                    name="open"
                    string="Not Done"
                    domain="[('status', 'in', ('draft', 'pending', 'error'))]"
                />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('status', '=', 'draft')]"
                />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('status', '=', 'pending')]"
                />
                <filter name="done" string="Done" domain="[('status', '=', 'done')]" />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('status', '=', 'cancelled')]"
                />
                <separator />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter
                        name="group_res_model"
                        string="Type"
                        context="{'group_by': 'res_model'}"
                    />
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_autopilot_activity" model="ir.actions.act_window">
        <field name="name">Activity</field>
        <field name="res_model">autopilot.activity</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_autopilot_activity"
        name="Activity"
        parent="menu_autopilot_connections"
        action="action_autopilot_activity"
        groups="base.group_system"
        sequence="1"
    />
</odoo>
