<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- No action: the app opens its first menu. A record, not a menuitem,
         because a menuitem never clears an action it once had. -->
    <record id="menu_autopilot_root" model="ir.ui.menu">
        <field name="name">Integrations &amp; Connections</field>
        <field name="web_icon">autopilot,static/description/icon.svg</field>
        <field name="sequence" eval="95" />
        <field name="action" eval="False" />
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <!-- Connectors add their menus here, after Activity and Connections. -->
    <menuitem
        id="menu_autopilot_connections"
        name="Integrations &amp; Connections"
        parent="menu_autopilot_root"
        sequence="10"
    />

    <menuitem
        id="menu_autopilot_scheduled_actions"
        name="Scheduled Actions"
        parent="menu_autopilot_root"
        action="base.ir_cron_act"
        groups="base.group_system"
        sequence="90"
    />

    <menuitem
        id="menu_autopilot_automation_rules"
        name="Automation Rules"
        parent="menu_autopilot_root"
        action="base_automation.base_automation_act"
        groups="base.group_system"
        sequence="91"
    />
</odoo>
