<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rule_autopilot_connection_company" model="ir.rule">
        <field name="name">Connection: multi-company</field>
        <field name="model_id" ref="model_autopilot_connection" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_activity_company" model="ir.rule">
        <field name="name">Integration Activity: multi-company</field>
        <field name="model_id" ref="model_autopilot_activity" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
