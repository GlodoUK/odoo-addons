<odoo>
    <record id="view_template_property_form" model="ir.ui.view">
        <field name="name">view_template_property_form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='sale_delay']]" position="after">
                <label
                    for="sale_delay_method"
                    string="Lead Time Method"
                    invisible="not sale_ok"
                />
                <div invisible="not sale_ok">
                    <field
                        name="sale_delay_method"
                        class="oe_inline"
                        style="vertical-align:baseline"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
