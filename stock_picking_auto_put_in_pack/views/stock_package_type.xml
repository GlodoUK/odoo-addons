<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_package_type_form" model="ir.ui.view">
        <field name="name">stock.package.type.form</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="product_capacity" string="Product Capacity">
                    <field name="product_capacity_ids">
                        <list editable="bottom">
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="uom_id" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
