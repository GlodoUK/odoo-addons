<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_put_in_pack_form" model="ir.ui.view">
        <field name="name">stock_put_in_pack_form</field>
        <field name="model">stock.put.in.pack</field>
        <field name="inherit_id" ref="stock.stock_put_in_pack_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='package_type_id']" position="before">
                <field name="missing_capacity_warning" invisible="1" />
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="auto_put_in_pack != 'auto' or not missing_capacity_warning"
                    colspan="2"
                >
                    No capacity defined for: <field
                    name="missing_capacity_warning"
                    readonly="1"
                    class="oe_inline"
                />. These lines will fall back to weight/volume constraints or be left unsplit.
                </div>
                <field
                    name="auto_put_in_pack"
                    widget="radio"
                    options="{'horizontal': true}"
                />
            </xpath>
            <xpath expr="//field[@name='result_package_id']" position="attributes">
                <attribute name="invisible">auto_put_in_pack != "no"</attribute>
            </xpath>
        </field>
    </record>
</odoo>
