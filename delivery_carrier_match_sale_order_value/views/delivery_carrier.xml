<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">view_delivery_carrier_form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='must_have_tag_ids']" position="before">
                <label for="max_sale_order_value_mode" string="Max Order Value" />
                <div class="o_row">
                    <field name="max_sale_order_value_mode" />
                    <field
                        name="max_sale_order_value_amount"
                        class="oe_inline"
                        invisible="max_sale_order_value_mode == 'no'"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
