<odoo>
    <record id="glo_post_msg_log_time_wizard_form" model="ir.ui.view">
        <field name="name">glo_post_msg_log_time_wizard_form</field>
        <field name="model">glo.post.msg.log.time.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="helpdesk_ticket_id" />
                    </group>
                    <group>
                        <field name="hours_spent" widget="timesheet_uom" />
                    </group>
                </group>
                <group>
                    <field name="message" />
                </group>
                <footer>
                    <button
                        type="object"
                        name="post_hours_and_message"
                        string="Confirm"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
