<odoo>
    <record
        id="helpdesk_timesheet_subscription_helpdesk_ticket_view_form"
        model="ir.ui.view"
    >
        <field
            name="name"
        >helpdesk_timesheet_subscription_helpdesk_ticket_view_form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='assign_ticket_to_self']" position="after">
                <field name="is_using_timesheets" invisible="1" />
                <button
                    class="btn-primary"
                    name="action_post_message_n_log_time"
                    type="object"
                    string="Msg and Time"
                    data-hotkey="l"
                    title="Posts Message and Logs Time"
                    icon="fa-smile-o"
                    attrs="{'invisible': [('is_using_timesheets', '!=', True)]}"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1" position="inside">
                <span class="oe_read_only badge badge-secondary float-right">
                    <field name="glo_total_hours_spent" widget="timesheet_uom" />
                </span>
            </xpath>
            <xpath expr="//sheet/field[@name='kanban_state']" position="before">
                <span class="float-right mx-3">
                    <h1>
                        <span class="oe_edit_only badge badge-secondary">
                            <field
                                name="glo_total_hours_spent"
                                widget="timesheet_uom"
                            />
                        </span>
                    </h1>
                </span>
            </xpath>
        </field>
    </record>
    <record
        id="helpdesk_timesheet_subscription_helpdesk_ticket_view_kanban"
        model="ir.ui.view"
    >
        <field
            name="name"
        >helpdesk_timesheet_subscription_helpdesk_ticket_view_kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('oe_kanban_bottom_right')]/field[@name='kanban_state']"
                position="before"
            >
                <span class="badge badge-secondary float-right mr-2 ">
                    <field name="total_hours_spent" widget="timesheet_uom" />
                </span>
            </xpath>
        </field>
    </record>
</odoo>
