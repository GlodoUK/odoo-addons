<odoo>
    <record id="helpdesk_timesheet_subscription_view_partner_form" model="ir.ui.view">
        <field name="name">helpdesk_timesheet_subscription_view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
<!--            <xpath expr="//div[@name='button_box']" position="inside">-->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="inside">
               <button
                    class="btn btn-outline-primary btn-lg float-right"
                    icon="fa-info-circle"
                    type="object"
                    name="action_redirect_to_company_balance"
                    attrs="{'invisible':[('company_type','not in', ['person', 'company'])]}"
                >
                   <field name="glo_sum_time_balance" widget="float_time" />
                   Balance
               </button>
            </xpath>
        </field>
    </record>
</odoo>
