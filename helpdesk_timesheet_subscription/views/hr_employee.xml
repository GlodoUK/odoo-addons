<odoo>
    <record id="helpdesk_timesheet_subscription_view_employee_form" model="ir.ui.view">
        <field name="name">helpdesk_timesheet_subscription_view_employee_form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="glo_default_log_time_id" />
            </xpath>
        </field>
    </record>
</odoo>
