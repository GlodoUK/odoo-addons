<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_delivery_document_fsc"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="product_fsc.fsc_claim_block">
                <t t-set="fsc_lines" t-value="o.move_ids.filtered('fsc_label')" />
                <t t-set="company" t-value="o.company_id" />
            </t>
        </xpath>
    </template>
</odoo>
