<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute
                    name="invisible"
                    add="delivery_type == 'base_on_code'"
                    separator=" or "
                />
            </xpath>

            <xpath expr="//field[@name='integration_level']" position="attributes">
                <attribute
                    name="invisible"
                    add="delivery_type == 'base_on_code'"
                    separator=" or "
                />
            </xpath>

            <xpath expr="//field[@name='invoice_policy']" position="attributes">
                <attribute
                    name="invisible"
                    add="delivery_type == 'base_on_code'"
                    separator=" or "
                />
            </xpath>

            <xpath expr="//field[@name='tracking_url']" position="attributes">
                <attribute
                    name="invisible"
                    add="delivery_type == 'base_on_code'"
                    separator=" or "
                />
            </xpath>

            <xpath expr="//page[@name='destination']" position="before">
                <page string="Code Pricing" invisible="delivery_type != 'base_on_code'">
                    <field
                        name="code"
                        nolabel="1"
                        widget="code"
                        options="{'mode': 'python'}"
                        required="delivery_type == 'base_on_code'"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
