<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="rounding_method" position="after">
                <setting
                    id="plastic_tax_setting"
                    string="Plastic Tax"
                    company_dependent="1"
                    help="Rate per kg, and which weight of a shipment it is charged on."
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                for="plastic_tax_basis"
                                string="Basis"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="plastic_tax_basis" />
                        </div>
                        <div class="row">
                            <label
                                for="plastic_tax_rate"
                                string="Rate per kg"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="plastic_tax_rate" />
                        </div>
                        <div class="row">
                            <label
                                for="plastic_tax_currency_id"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="plastic_tax_currency_id"
                                options="{'no_create': True}"
                            />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
