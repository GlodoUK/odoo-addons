<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">glo.brand.form</field>
        <field name="model">glo.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar" />

                    <div class="oe_title">
                        <label for="name" string="Brand Name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group>
                        <group colspan="2">
                            <field name="is_default" />
                            <field name="active" />
                            <field name="partner_id" />
                        </group>
                        <group string="Partner Details" col="2">
                            <label for="street" string="Address" />
                            <div>
                                <field name="street" />
                                <field name="street2" invisible="not street2" />
                                <field name="city" invisible="not city" />
                                <field name="state_id" invisible="not state_id" />
                                <field name="zip" invisible="not zip" />
                                <field name="country_id" invisible="not country_id" />
                            </div>
                            <field name="phone" />
                            <field name="email" />
                            <field name="website" />
                            <field name="vat" />
                        </group>
                        <group string="Report Details" col="2">
                            <field name="report_header" />
                            <field name="report_footer" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_brand_search_form_view" model="ir.ui.view">
        <field name="name">glo.brand.search</field>
        <field name="model">glo.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="is_default" />
            </search>
        </field>
    </record>

    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">glo.brand.tree</field>
        <field name="model">glo.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Brand</field>
        <field name="res_model">glo.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="product_brand_menu"
        action="action_product_brand"
        parent="sale.menu_sale_config"
        name="Brands"
        sequence="6"
    />
</odoo>
