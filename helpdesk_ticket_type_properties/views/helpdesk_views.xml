<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='properties']/parent::div" position="replace" />

            <xpath expr="//field[@name='description']" position="before">
                <div class="row">
                <div class="col-6">
                    <label for="properties" string="Team properties" />
                    <field
                            name="properties"
                            nolabel="1"
                            columns="2"
                            hideKanbanOption="1"
                        />
                </div>

                <div
                        class="col-6"
                        attrs="{'invisible': [('ticket_type_id', '=', False)]}"
                    >
                    <label for="ticket_type_properties" string="Type properties" />
                    <field
                            name="ticket_type_properties"
                            nolabel="1"
                            columns="2"
                            hideKanbanOption="1"
                        />
                </div>
</div>
            </xpath>
        </field>
    </record>
</odoo>
