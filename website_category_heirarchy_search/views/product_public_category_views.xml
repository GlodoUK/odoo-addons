<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_public_category_form_view_inherit" model="ir.ui.view">
        <field name="name">product.public.category.form.category_search</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_description']" position="before">
                <field name="show_in_search_widget" />
            </xpath>
        </field>
    </record>
</odoo>
