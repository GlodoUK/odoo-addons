<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="product_banding_form" model="ir.ui.view">
        <field name="name">product.banding.form</field>
        <field name="model">cpq.banding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_children"
                            icon="fa-clone"
                        >
                            <field
                                string="Children"
                                name="child_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>

                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Red" />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="parent_id" />
                            <field name="ref" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="comment" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_banding_tree" model="ir.ui.view">
        <field name="name">product.banding.list</field>
        <field name="model">cpq.banding</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" />
                <field name="child_count" string="Children" />
            </list>
        </field>
    </record>

    <record id="view_product_banding_search" model="ir.ui.view">
        <field name="name">view_product_banding_search</field>
        <field name="model">cpq.banding</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    filter_domain="['|', ('complete_name', 'ilike', self), ('ref', 'ilike', self)]"
                />
                <filter
                    string="Roots"
                    name="filter_root"
                    domain="[('parent_id', '=', False)]"
                />
                <filter
                    string="Leaves"
                    name="filter_is_leaf"
                    domain="[('is_leaf', '=', True)]"
                />
                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_archived"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        string="Parent"
                        name="group_by_parent"
                        context="{'group_by': 'parent_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="product_banding_action" model="ir.actions.act_window">
        <field name="name">Banding</field>
        <field name="res_model">cpq.banding</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Banding
            </p>
        </field>
    </record>

    <menuitem
        id="menu_sale_banding"
        name="Banding"
        parent="sale.prod_config_main"
        action="product_banding_action"
        sequence="10"
    />
    <menuitem
        id="menu_stock_banding"
        name="Banding"
        parent="stock.menu_product_in_config_stock"
        action="product_banding_action"
        sequence="4"
    />
</odoo>
