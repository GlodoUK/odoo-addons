<odoo>
    <template
        id="helpdesk_escalate_tickets_followup_escalate"
        name="Helpdesk Tickets"
        inherit_id="helpdesk.tickets_followup"
        priority="75"
    >
        <xpath expr="//div[hasclass('text-truncate')]" position="inside">
            <div
                t-if="ticket.can_be_escalated and not ticket.stage_id.is_close and not ticket.closed_by_partner"
                class="modal"
                tabindex="-1"
                role="dialog"
                id="helpdesk_ticket_escalate_modal"
            >
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Escalate ticket</h5>
                            <button
                                type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Escalate"
                            >
                                ×
                            </button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you wish to escalate this ticket?</p>
                        </div>
                        <div class="modal-footer">
                            <a
                                role="button"
                                class="btn btn-primary"
                                t-att-href="'/my/ticket/escalate/%s/%s' % (ticket.id, ticket.access_token)"
                            >
                                Escalate the ticket
                            </a>
                            <button
                                type="button"
                                class="btn btn-light"
                                data-dismiss="modal"
                            >
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <button
                t-if="ticket.can_be_escalated and not ticket.stage_id.is_close and not ticket.closed_by_partner"
                class="btn btn-info btn-sm float-right"
                data-target="#helpdesk_ticket_escalate_modal"
                data-toggle="modal"
            >
                <small
                    data-toggle="tooltip"
                    title="If you feel this ticket needs more urgent attention, you can escalate it."
                >
                    <b>Escalate this ticket</b>
                </small>
            </button>
        </xpath>
    </template>
</odoo>
