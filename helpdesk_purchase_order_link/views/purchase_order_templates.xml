<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
        priority="99"
    >
        <xpath expr="//div[@t-if='o.user_id']" position="replace">
            <div t-if="o.helpdesk_ticket_ids" class="col-3 bm-2">
                <strong>GloHelp Reference:</strong>
                <t t-foreach="o.helpdesk_ticket_ids" t-as="ticket">
                    <p class="m-0" t-field="ticket.display_name" />
                </t>
            </div>
        </xpath>
    </template>
</odoo>
