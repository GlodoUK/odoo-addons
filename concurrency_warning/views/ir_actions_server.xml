<odoo>
    <record model="ir.ui.view" id="view_server_action_form">
        <field name="name">view_server_action_form</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='action_content']" position="inside">
                <field name="poke_msg" invisible="state != 'poke'" />
                <field name="poke_refresh" invisible="state != 'poke'" />
                <field name="poke_type" invisible="state != 'poke'" />
                <field name="poke_sticky" invisible="state != 'poke'" />
            </xpath>
        </field>
    </record>
</odoo>
