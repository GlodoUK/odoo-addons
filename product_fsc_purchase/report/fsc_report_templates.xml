<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document_fsc"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//div[@id='total']" position="after">
            <t t-call="product_fsc.fsc_claim_block">
                <t t-set="fsc_lines" t-value="o.order_line.filtered('fsc_label')" />
                <t t-set="company" t-value="o.company_id" />
            </t>
        </xpath>
    </template>
    <template
        id="report_purchasequotation_document_fsc"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <xpath expr="//p[@t-field='o.note']" position="before">
            <t t-call="product_fsc.fsc_claim_block">
                <t t-set="fsc_lines" t-value="o.order_line.filtered('fsc_label')" />
                <t t-set="company" t-value="o.company_id" />
            </t>
        </xpath>
    </template>
</odoo>
