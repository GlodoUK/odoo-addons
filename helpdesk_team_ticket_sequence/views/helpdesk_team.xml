<odoo>
    <record model="ir.ui.view" id="helpdesk_team_view_form">
        <field name="name">helpdesk_team_view_form</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='productivity']" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="ticket_sequence_id" />
                        <div class="text-muted">
                            Used to automatically name and number tickets with a sequence, rather than the ID number of the helpdesk ticket record
                        </div>
                        <div>
                            <field name="ticket_sequence_id" />
                        </div>
                        <button
                            type="object"
                            name="set_sequence_to_tickets_wo_number"
                            string="Assign Sequence To Tickets Without Numbers"
                            class="oe_highlight"
                            groups="base.group_no_one"
                            attrs="{'invisible': [('ticket_sequence_id', '=', False)]}"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
