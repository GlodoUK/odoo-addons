<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="template_helpdesk_ticket_new"
        inherit_id="helpdesk_portal_new_ticket.template_helpdesk_ticket_new"
    >
        <div id="div_ticket_categ_id" position="attributes">
            <attribute name="class">my-3</attribute>
        </div>

        <div id="div_ticket_categ_id" position="inside">
            <label class="form-label" for="ticket_categ_id">
                Category
            </label>

            <select
                class="form-select"
                id="ticket_categ_id"
                name="ticket_categ_id"
                required="required"
            >
                <option
                    value=""
                    disabled="disabled"
                    hidden="hidden"
                    selected="selected"
                >
                    Select your category
                </option>

                <t t-foreach="ticket_categ_ids" t-as="categ">
                    <option
                        t-att-selected="'selected' if default_categ_id == categ else False"
                        t-att-value="categ.id"
                        t-out="categ.display_name"
                    />
                </t>
            </select>
        </div>
    </template>
</odoo>
