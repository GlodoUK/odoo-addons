<odoo>
    <record model="ir.ui.view" id="view_edi_envelope_route_form">
        <field name="name">view_edi_envelope_route_form</field>
        <field name="model">edi.envelope.route</field>
        <field name="inherit_id" ref="connector_edi.view_edi_envelope_route_form" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='codec']" position="inside">
                <group name="codec_edination" attrs="{'invisible': [('codec', '!=', 'edination')]}">
                    <field name="codec_edination_url" attrs="{'required': [('codec', '=', 'edination')]}"/>
                    <field name="codec_edination_apikey" attrs="{'required': [('codec', '=', 'edination')]}"/>
                    <field name="codec_edination_open" attrs="{'required': [('codec', '=', 'edination')]}"/>
                    <field name="codec_edination_enclose" attrs="{'required': [('codec', '=', 'edination')]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
