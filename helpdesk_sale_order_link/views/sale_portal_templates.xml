<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="sale_order_portal_content"
        inherit_id="sale.sale_order_portal_content"
        priority="75"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div
                t-if="sale_order.helpdesk_tickets_ids"
                class="row mb-4"
                name="Ticket"
                id="ticket"
            >
                <div class="col-12">
                    <strong>Linked Helpdesk Tickets</strong>
                    <p t-foreach="sale_order.helpdesk_tickets_ids" t-as="ticket">
                        <a t-attf-href="/helpdesk/ticket/#{ticket.id}">
                            <t t-out="ticket.ticket_ref" />
                        </a>
                    </p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
