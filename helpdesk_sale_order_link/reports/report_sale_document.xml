<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//div[@id='informations']" position="inside">
            <div
                class="col-auto col-3 mw-100 mb-2"
                t-if="doc.helpdesk_tickets_ids"
                name="ticket_ids"
            >
                <strong>Helpdesk Ticket(s):</strong>
                <p
                    class="m-0"
                    t-out="', '.join(doc.helpdesk_tickets_ids.mapped('ticket_ref'))"
                />
            </div>
        </xpath>
    </template>
</odoo>
