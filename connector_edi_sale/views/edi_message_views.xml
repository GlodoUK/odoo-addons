<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="view_edi_message_form" model="ir.ui.view">
        <field name="name">edi.message.form</field>
        <field name="model">edi.message</field>
        <field name="inherit_id" ref="connector_edi.view_edi_message_form" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <page name="related_docs" position="inside">
                <group>
                    <field name="edi_sale_order_ids" string="Orders">
                        <list>
                            <field name="odoo_id" widget="many2one" />
                            <field name="state" />
                            <field name="create_date" />
                            <field name="write_date" />
                        </list>
                    </field>
                </group>
            </page>
        </field>
    </record>
</odoo>
