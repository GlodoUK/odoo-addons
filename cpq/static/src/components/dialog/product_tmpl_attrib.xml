<?xml version='1.0' encoding='utf-8' ?>
<templates xml:space="preserve">

    <t t-name="cpq.ProductTmplAttrib">
        <div class="mb-3">
            <div class="mb-2">
                <label class="form-label fw-bold" t-out="props.attribute.name" />
                <t t-call="{{ getPTAVTemplate() }}" />
            </div>

            <div t-if="selectedCustomPTAVs.length" class="mb-2">
                <div
                    t-foreach="selectedCustomPTAVs"
                    t-as="ptav"
                    t-key="ptav.id"
                    class="mb-2"
                >
                    <strong t-out="ptav.name" class="form-label d-block" />
                    <input
                        t-if="ptav.cpq_custom_type !== 'many2one'"
                        class="form-control o_input"
                        t-att-type="getCustomInputType(ptav)"
                        t-att-step="getCustomStep(ptav)"
                        t-att-value="props.selected[ptav.id]"
                        t-att-data-ptav-id="ptav.id"
                        t-on-input="onCustomInput"
                    />
                    <div
                        t-else=""
                        class="text-muted small"
                    >Unsupported custom field type.</div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="cpq.ProductTmplAttribSelect">
        <select
            class="form-select"
            t-on-change="onSelect"
            t-att-name="'ptal-' + props.id"
            t-att-id="'ptal-' + props.id"
        >
            <option value="" />
            <option
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                t-att-value="ptav.id"
                t-att-selected="isSelected(ptav.id)"
                t-att-class="{ 'css_not_available': ptav.excluded }"
                t-out="ptav.name"
            />
        </select>
    </t>

    <t t-name="cpq.ProductTmplAttribRadio">
        <div class="d-flex flex-column gap-2">
            <div
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                class="form-check form-check-inline mb-0"
            >
                <input
                    type="radio"
                    class="form-check-input"
                    t-att-id="'ptav-' + ptav.id"
                    t-att-value="ptav.id"
                    t-att-checked="isSelected(ptav.id)"
                    t-att-name="'ptal-' + props.id"
                    t-on-change="onSelect"
                    t-attf-style="accent-color: {{ ptav.html_color ? ptav.html_color : '' }}"
                />
                <label
                    class="form-check-label"
                    t-att-class="{ 'css_not_available': ptav.excluded }"
                    t-att-for="'ptav-' + ptav.id"
                >
                    <span t-out="ptav.name" />
                </label>
            </div>
        </div>
    </t>

    <t t-name="cpq.ProductTmplAttribColor">
        <ul class="list-inline mb-0">
            <li
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                class="list-inline-item me-1"
            >
                <t
                    t-set="img_style"
                    t-value="ptav.image ? 'background-image: url(/web/image/product.template.attribute.value/' + ptav.id + '/image); background-size: cover;' : ''"
                />
                <t
                    t-set="color_style"
                    t-value="ptav.is_custom ? '' : 'background-color: ' + ptav.html_color"
                />
                <label
                    t-attf-style="#{img_style or color_style}; width: 36px; height: 36px;"
                    t-attf-class="css_attribute_color #{isSelected(ptav.id) ? 'active' : ''}"
                    t-att-title="ptav.name"
                >
                    <input
                        type="radio"
                        class="form-check-input"
                        t-att-id="'ptav-' + ptav.id"
                        t-att-value="ptav.id"
                        t-att-checked="isSelected(ptav.id)"
                        t-att-name="'ptal-' + props.id"
                        t-on-change="onSelect"
                        t-attf-style="accent-color: {{ ptav.html_color ? ptav.html_color : '' }}"
                    />
                </label>
            </li>
        </ul>
    </t>

    <t t-name="cpq.ProductTmplAttribImage">
        <ul class="list-inline mb-0">
            <li
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                class="list-inline-item me-2"
            >
                <t
                    t-set="img_style"
                    t-value="ptav.image ? 'background-image: url(/web/image/product.template.attribute.value/' + ptav.id + '/image); background-size: cover;' : ''"
                />
                <label
                    class="position-relative d-inline-block text-center o_sale_product_configurator_ptav_image rounded-3 cursor-pointer"
                    t-att-title="ptav.name"
                    t-attf-style="#{img_style}"
                    t-att-class="{
                        'active': isSelected(ptav.id),
                        'custom_value': ptav.is_custom,
                        'transparent': !ptav.is_custom and !ptav.html_color,
                        'css_not_available': ptav.excluded
                    }"
                >
                    <input
                        type="radio"
                        class="w-100 h-100 opacity-0 cursor-pointer"
                        t-att-id="'ptav-' + ptav.id"
                        t-att-value="ptav.id"
                        t-att-checked="isSelected(ptav.id)"
                        t-att-name="'ptal-' + props.id"
                        t-on-change="onSelect"
                    />
                </label>
            </li>
        </ul>
    </t>

</templates>
