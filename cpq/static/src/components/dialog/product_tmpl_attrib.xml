<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t t-name="cpq.ProductTmplAttrib" owl="1">
        <div class="mb-3">
            <div class="mb-2">
                <label
                    t-if="props.attribute.ptav_ids.length &gt; 1 or hasCustomPTAV"
                    class="form-label fw-bold"
                    t-esc="props.attribute.name"
                />
                <t t-call="{{ getPTAVTemplate() }}" />
            </div>

            <div t-if="selectedCustomPTAVs.length" class="mb-2">
                <div t-foreach="selectedCustomPTAVs" t-as="ptav" t-key="ptav.id" class="mb-2">
                    <strong t-esc="ptav.name" class="form-label d-block" />
                    <input
                        t-if="ptav.cpq_custom_type !== 'many2one'"
                        class="form-control o_input"
                        t-att-type="getCustomInputType(ptav)"
                        t-att-step="getCustomStep(ptav)"
                        t-att-value="props.selected[ptav.id]"
                        t-att-data-ptav-id="ptav.id"
                        t-on-input="onCustomInput"
                    />
                    <div t-else="" class="text-muted small">Unsupported custom field type.</div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="cpq.ProductTmplAttribSelect" owl="1">
        <select
            class="form-select"
            t-on-change="onSelect"
            t-att-name="'ptal-' + props.id"
            t-att-id="'ptal-' + props.id"
        >
            <option value="" />
            <option
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                t-att-value="ptav.id"
                t-att-selected="isSelected(ptav.id)"
                t-att-class="{ 'css_not_available': ptav.excluded }"
                t-esc="ptav.name"
            />
        </select>
    </t>

    <t t-name="cpq.ProductTmplAttribRadio" owl="1">
        <div class="d-flex flex-wrap gap-3">
            <div t-foreach="props.attribute.ptav_ids" t-as="ptav" t-key="ptav.id" class="form-check form-check-inline mb-0">
                <input
                    type="radio"
                    class="form-check-input"
                    t-att-id="'ptav-' + ptav.id"
                    t-att-value="ptav.id"
                    t-att-checked="isSelected(ptav.id)"
                    t-att-name="'ptal-' + props.id"
                    t-on-change="onSelect"
                    t-attf-style="accent-color: {{ ptav.html_color ? ptav.html_color : '' }}"
                />
                <label
                    class="form-check-label"
                    t-att-class="{ 'css_not_available': ptav.excluded }"
                    t-att-for="'ptav-' + ptav.id"
                >
                    <span t-esc="ptav.name" />
                </label>
            </div>
        </div>
    </t>

    <t t-name="cpq.ProductTmplAttribColor" owl="1">
        <ul class="list-inline mb-0">
            <li
                t-foreach="props.attribute.ptav_ids"
                t-as="ptav"
                t-key="ptav.id"
                class="list-inline-item me-1"
            >
                <label
                    t-attf-style="background-color: {{ ptav.is_custom ? '' : ptav.html_color }}; width: 36px; height: 36px;"
                    t-attf-class="css_attribute_color #{isSelected(ptav.id) ? 'active' : ''}"
                    t-att-title="ptav.name"
                >
                    <input
                        type="radio"
                        class="form-check-input"
                        t-att-id="'ptav-' + ptav.id"
                        t-att-value="ptav.id"
                        t-att-checked="isSelected(ptav.id)"
                        t-att-name="'ptal-' + props.id"
                        t-on-change="onSelect"
                        t-attf-style="accent-color: {{ ptav.html_color ? ptav.html_color : '' }}"
                    />
                </label>
            </li>
        </ul>
    </t>

</templates>
