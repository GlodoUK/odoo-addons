<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_edi_envelope_vacuum" model="ir.cron">
        <field name="name">AutoVacuum EDI Envelope Content</field>
        <field name="state">code</field>
        <field name="model_id" ref="model_edi_envelope_route" />
        <field name="code">model.search([]).action_vacuum_content()</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_edi_message_vacuum" model="ir.cron">
        <field name="name">AutoVacuum EDI Message Content</field>
        <field name="state">code</field>
        <field name="model_id" ref="model_edi_route" />
        <field name="code">model.search([]).action_vacuum_content()</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
