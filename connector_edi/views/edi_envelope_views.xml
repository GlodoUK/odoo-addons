<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_edi_envelope_form" model="ir.ui.view">
        <field name="name">edi.envelope.form</field>
        <field name="model">edi.envelope</field>
        <field name="arch" type="xml">
            <form string="EDI envelope">
                <header>
                    <button
                        string="Migrate Legacy Body to Attachment"
                        type="object"
                        name="action_migrate_legacy_body_to_attachment"
                        invisible="not use_legacy_body"
                    />

                    <button string="Process" type="object" name="run" />

                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_messages"
                            icon="fa-envelope-open-o"
                        >
                            <field
                                name="message_count"
                                string="Messages"
                                widget="statinfo"
                            />
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="route_id" />
                            <field name="partner_id" />
                        </group>

                        <group>
                            <field name="direction" />
                            <field name="external_id" />
                            <field name="type" />
                        </group>

                        <group colspan="4" invisible="state != 'error'">
                            <field name="exc_name" />
                            <field name="exc_info" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Content">
                            <group invisible="use_legacy_body">
                                <field
                                    name="content_filename"
                                    groups="base.group_no_one"
                                    readonly="1"
                                />
                                <field
                                    name="content"
                                    filename="content_filename"
                                    widget="binary"
                                />
                            </group>
                            <field name="legacy_body" invisible="not use_legacy_body" />
                        </page>

                        <page string="Other Info" name="other">
                            <group>
                                <field name="metadata_string" />
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_edi_envelope_tree" model="ir.ui.view">
        <field name="name">edi.envelope.list</field>
        <field name="model">edi.envelope</field>
        <field name="arch" type="xml">
            <list
                default_order="create_date desc"
                decoration-danger="state == 'error'"
                decoration-success="state == 'done'"
            >
                <field name="create_date" />
                <field name="external_id" />
                <field name="backend_id" />
                <field name="partner_id" />
                <field name="route_id" />
                <field name="direction" />
                <field name="state" />
                <field name="message_count" />
            </list>
        </field>
    </record>

    <record id="view_edi_envelope_search" model="ir.ui.view">
        <field name="name">edi.envelope.search</field>
        <field name="model">edi.envelope</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="route_id" />
                <field name="external_id" />

                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <filter
                    string="Error"
                    name="error"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    string="Pending"
                    name="pending"
                    domain="[('state', '=', 'pending')]"
                />
                <separator />
                <filter
                    string="In"
                    name="filter_in"
                    domain="[('direction', '=', 'in')]"
                />
                <filter
                    string="Out"
                    name="filter_out"
                    domain="[('direction', '=', 'out')]"
                />
            </search>
        </field>
    </record>

    <record id="action_edi_envelope" model="ir.actions.act_window">
        <field name="name">EDI Envelopes</field>
        <field name="res_model">edi.envelope</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_edi_envelope_tree" />
    </record>

    <record id="action_edi_envelope_requeue" model="ir.actions.server">
        <field name="name">Requeue</field>
        <field name="model_id" ref="connector_edi.model_edi_envelope" />
        <field name="binding_model_id" ref="connector_edi.model_edi_envelope" />
        <field name="state">code</field>
        <field name="code">
            records.action_pending()
        </field>
    </record>
</odoo>
