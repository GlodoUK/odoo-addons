<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_edi_message_form" model="ir.ui.view">
        <field name="name">edi.message.form</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <form string="EDI message">
                <header>
                    <button
                        type="object"
                        string="Migrate Legacy Body To Attachment"
                        name="action_migrate_legacy_body_to_attachment"
                        invisible="not use_legacy_body"
                    />

                    <button
                        type="object"
                        string="Read Message"
                        name="action_read"
                        invisible="direction != 'in'"
                    />

                    <button
                        type="object"
                        string="Send Message"
                        name="action_send"
                        invisible="direction != 'out'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                    />
                </header>

                <sheet>
                    <div name="button_box" class="oe_button_box" />

                    <group>
                        <group>
                            <field name="backend_id" />
                            <field name="partner_id" />
                            <field name="external_id" />
                            <field name="direction" />
                            <field name="type" />
                        </group>

                        <group>
                            <field name="envelope_id" />
                            <field
                                name="message_route_id"
                                domain="[('backend_id', '=', backend_id)]"
                            />
                            <field
                                name="envelope_route_id"
                                domain="[('backend_id', '=', backend_id)]"
                            />
                            <field name="test" />
                        </group>

                        <group colspan="4" invisible="state != 'error'">
                            <field name="exc_name" />
                            <field name="exc_info" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Content">
                            <group invisible="use_legacy_body">
                                <field
                                    name="content_filename"
                                    groups="base.group_no_one"
                                    readonly="1"
                                />
                                <field
                                    name="content"
                                    filename="content_filename"
                                    widget="binary"
                                />
                            </group>
                            <field name="legacy_body" invisible="not use_legacy_body" />
                        </page>

                        <page string="Related Documents" name="related_docs">
                            <group>
                                <field name="res_id" />
                                <field name="model" />
                                <field name="related" widget="reference" />
                            </group>

                            <group>
                                <field name="acknowledged" />
                                <field name="acknowledgement_message_id" />
                                <field name="acknowledgement_for_message_ids">
                                    <list>
                                        <field name="display_name" />
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Other Info" name="other">
                            <group>
                                <field name="metadata_string" />
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_edi_message_tree" model="ir.ui.view">
        <field name="name">edi.message.list</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'error'"
                decoration-success="state == 'done'"
            >
                <field name="create_date" />
                <field name="backend_id" />
                <field name="partner_id" />
                <field name="external_id" />
                <field name="direction" />
                <field name="type" />
                <field name="envelope_id" widget="many2one" />
                <field name="message_route_id" widget="many2one" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_edi_message_search" model="ir.ui.view">
        <field name="name">edi.message.search</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="message_route_id" />
                <field name="envelope_route_id" />
                <field name="external_id" />

                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <filter
                    string="Error"
                    name="error"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    string="Pending"
                    name="pending"
                    domain="[('state', '=', 'pending')]"
                />
                <separator />

                <filter
                    string="In"
                    name="filter_in"
                    domain="[('direction', '=', 'in')]"
                />
                <filter
                    string="Out"
                    name="filter_in"
                    domain="[('direction', '=', 'out')]"
                />
            </search>
        </field>
    </record>

    <record id="action_edi_message" model="ir.actions.act_window">
        <field name="name">EDI Messages</field>
        <field name="res_model">edi.message</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_edi_message_tree" />
    </record>

    <record id="action_edi_message_requeue" model="ir.actions.server">
        <field name="name">Requeue</field>
        <field name="model_id" ref="connector_edi.model_edi_message" />
        <field name="binding_model_id" ref="connector_edi.model_edi_message" />
        <field name="state">code</field>
        <field name="code">
            records.action_pending()
        </field>
    </record>
</odoo>
