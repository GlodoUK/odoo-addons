<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_edi_route_event_tree" model="ir.ui.view">
        <field name="name">edi.route.event.list</field>
        <field name="model">edi.route.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" />
            </list>
        </field>
    </record>

    <record id="view_edi_route_event_search" model="ir.ui.view">
        <field name="name">edi.route.event.search</field>
        <field name="model">edi.route.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="res_model" />
            </search>
        </field>
    </record>
</odoo>
