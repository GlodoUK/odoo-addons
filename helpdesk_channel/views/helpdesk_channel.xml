<odoo>
    <record id="helpdesk_channel_view_tree" model="ir.ui.view">
        <field name="name">helpdesk_channel_view_tree</field>
        <field name="model">helpdesk.channel</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="helpdesk_channel_view_form" model="ir.ui.view">
        <field name="name">helpdesk_channel_view_form</field>
        <field name="model">helpdesk.channel</field>
        <field name="arch" type="xml">
            <form string="Team" class="oe_form_configuration">
                <sheet>
                    <div class="oe_title" id='title'>
                        <label for="name" class="oe_edit_only" />
                        <h1 id="name">
                            <field name="name" placeholder="Helpdesk channel..." />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="helpdesk_channel_action" model="ir.actions.act_window">
        <field name="name">Helpdesk Channels</field>
        <field name="res_model">helpdesk.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new channel for your helpdesk team
            </p>
            <p>
                Automatically apply channels to your helpdesk tickets
            </p>
        </field>
    </record>
    <menuitem
        name="Helpdesk Channels"
        id="menu_helpdesk_channels"
        parent="helpdesk.helpdesk_menu_config"
        action="helpdesk_channel_action"
    />
</odoo>
