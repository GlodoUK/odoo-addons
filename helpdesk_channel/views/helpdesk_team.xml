<odoo>
    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk_team_view_form</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form" />
        <field name="priority">75</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_form_channel']" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="default_channel_id" />
                        <div class="text-muted">
                            Team default assigned channel
                        </div>
                        <div>
                            <field name="default_channel_id" class="mt16" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
