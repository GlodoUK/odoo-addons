<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="gate_hold_view_tree" model="ir.ui.view">
        <field name="model">gate.hold</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="res_model" />
                <field name="res_id" />
                <field name="rule_id" />
                <field name="tier" />
                <field name="clearance_count" string="Clearances" />
                <field
                    name="state"
                    widget="badge"
                    decoration-warning="state == 'pending'"
                    decoration-muted="state == 'waiting'"
                    decoration-success="state == 'cleared'"
                />
            </list>
        </field>
    </record>

    <record id="gate_hold_view_form" model="ir.ui.view">
        <field name="model">gate.hold</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="rule_id" />
                            <field name="res_model" />
                            <field name="res_id" />
                        </group>
                        <group>
                            <field name="tier" />
                            <field name="state" />
                        </group>
                    </group>
                    <field name="clearance_ids">
                        <list create="false" editable="bottom">
                            <field name="user_id" />
                            <field name="date" />
                            <field name="note" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gate_hold_view_search" model="ir.ui.view">
        <field name="model">gate.hold</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_model" />
                <field name="rule_id" />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="waiting"
                    string="Waiting"
                    domain="[('state', '=', 'waiting')]"
                />
                <filter
                    name="cleared"
                    string="Cleared"
                    domain="[('state', '=', 'cleared')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_model"
                        string="Model"
                        context="{'group_by': 'res_model'}"
                    />
                    <filter
                        name="group_rule"
                        string="Rule"
                        context="{'group_by': 'rule_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="gate_hold_action" model="ir.actions.act_window">
        <field name="name">Gate Holds</field>
        <field name="res_model">gate.hold</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1, 'search_default_waiting': 1}</field>
    </record>
</odoo>
