<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_gate_manager" model="res.groups">
        <field name="name">Gate: Configuration</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
    <record id="group_gate_officer" model="res.groups">
        <field name="name">Gate: Officer (force clear)</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Managers and officers can configure; system implies both. -->
    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('base_gate.group_gate_manager')), (4, ref('base_gate.group_gate_officer'))]"
        />
    </record>
</odoo>
