<odoo>
    <record id="view_split_ticket_wizard" model="ir.ui.view">
        <field name="name">view_split_ticket_wizard</field>
        <field name="model">split.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Ticket From Message">
                <group>
                    <field name="message_id" string="Message" />
                    <field name="followers_available_ids" invisible="1" />
                </group>
                <group>
                    <field
                        name="description"
                        string="Ticket Description"
                        class="field_description"
                    />
                    <field
                        name="followers_keep_old"
                        string="Use same followers as origin message?"
                    />
                    <field
                        name="followers"
                        string="Followers"
                        widget="many2many_tags"
                        attrs="{'invisible': [('followers_keep_old', '=', True)]}"
                        domain="[('id', 'in', followers_available_ids)]"
                    />
                </group>
                <footer>
                    <button
                        type="object"
                        string="Split"
                        name="action_create_new_ticket"
                        class="btn btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
