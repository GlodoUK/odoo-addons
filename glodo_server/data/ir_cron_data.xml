<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_glodo_instance_health_check" model="ir.cron">
        <field name="name">Glodo Cloud: Instance Health Check</field>
        <field name="model_id" ref="model_glodo_instance" />
        <field name="state">code</field>
        <field name="code">model._cron_check_instances()</field>
        <field name="interval_number" eval="15" />
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_glodo_remote_user_rearchive" model="ir.cron">
        <field name="name">Archive Expired Remote Users</field>
        <field name="model_id" ref="model_glodo_remote_user" />
        <field name="state">code</field>
        <field name="code">model._cron_rearchive_expired_users()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">hours</field>
    </record>
</odoo>
