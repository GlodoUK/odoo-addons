<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_glodo_cloud" model="ir.module.category">
        <field name="name">Glodo Cloud</field>
        <field name="description">Manage Glodo Cloud permissions</field>
        <field name="sequence" eval="100" />
    </record>

    <record id="privilege_glodo_cloud" model="res.groups.privilege">
        <field name="name">Glodo Cloud</field>
        <field name="category_id" ref="module_category_glodo_cloud" />
    </record>

    <record id="group_glodo_cloud_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_glodo_cloud" />
        <field name="comment">Can view managed instances and remote users</field>
    </record>

    <record id="group_glodo_cloud_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_glodo_cloud" />
        <field name="implied_ids" eval="[(4, ref('group_glodo_cloud_user'))]" />
        <field
            name="comment"
        >Can manage instances, sync users, and perform become actions</field>
    </record>

    <record id="group_glodo_cloud_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_glodo_cloud" />
        <field name="implied_ids" eval="[(4, ref('group_glodo_cloud_manager'))]" />
        <field
            name="comment"
        >Full access including key management and enrollment</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="glodo_instance_rule_user" model="ir.rule">
        <field name="name">Glodo Instance: User can read active</field>
        <field name="model_id" ref="model_glodo_instance" />
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="glodo_instance_rule_manager" model="ir.rule">
        <field name="name">Glodo Instance: Manager full access</field>
        <field name="model_id" ref="model_glodo_instance" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="glodo_instance_rule_admin" model="ir.rule">
        <field name="name">Glodo Instance: Admin full access</field>
        <field name="model_id" ref="model_glodo_instance" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_admin'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="glodo_remote_user_rule_user" model="ir.rule">
        <field name="name">Glodo Remote User: User can read</field>
        <field name="model_id" ref="model_glodo_remote_user" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="glodo_remote_user_rule_manager" model="ir.rule">
        <field name="name">Glodo Remote User: Manager full access</field>
        <field name="model_id" ref="model_glodo_remote_user" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="glodo_action_log_rule_user" model="ir.rule">
        <field name="name">Glodo Action Log: User can read</field>
        <field name="model_id" ref="model_glodo_action_log" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="glodo_action_log_rule_manager" model="ir.rule">
        <field name="name">Glodo Action Log: Manager can read/create</field>
        <field name="model_id" ref="model_glodo_action_log" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_glodo_cloud_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
