<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="glodo_instance_host_view_list" model="ir.ui.view">
        <field name="name">glodo.instance.host.view.list</field>
        <field name="model">glodo.instance.host</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="glodo_instance_host_view_search" model="ir.ui.view">
        <field name="name">glodo.instance.host.view.search</field>
        <field name="model">glodo.instance.host</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="glodo_instance_host_action" model="ir.actions.act_window">
        <field name="name">Instance Hosts</field>
        <field name="res_model">glodo.instance.host</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
