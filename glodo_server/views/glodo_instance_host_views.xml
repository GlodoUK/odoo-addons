<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="glodo_instance_host_view_form" model="ir.ui.view">
        <field name="name">glodo.instance.host.view.form</field>
        <field name="model">glodo.instance.host</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Host Name" />
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1" />
                    </group>
                    <field name="host_properties_definition" nolabel="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="glodo_instance_host_view_list" model="ir.ui.view">
        <field name="name">glodo.instance.host.view.list</field>
        <field name="model">glodo.instance.host</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="glodo_instance_host_view_search" model="ir.ui.view">
        <field name="name">glodo.instance.host.view.search</field>
        <field name="model">glodo.instance.host</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="glodo_instance_host_action" model="ir.actions.act_window">
        <field name="name">Instance Hosts</field>
        <field name="res_model">glodo.instance.host</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
