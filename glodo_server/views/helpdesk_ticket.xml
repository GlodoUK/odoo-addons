<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Instance Form View -->
    <record id="glodo_helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">glodo.helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_instance"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-server"
                    invisible="not glodo_instance_ids"
                >
                    <span class="o_stat_text">View Instance</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
