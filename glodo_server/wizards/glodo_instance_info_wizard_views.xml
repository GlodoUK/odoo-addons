<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="glodo_instance_info_wizard_view_form" model="ir.ui.view">
        <field name="name">glodo.instance.info.wizard.view.form</field>
        <field name="model">glodo.instance.info.wizard</field>
        <field name="arch" type="xml">
            <form string="Instance Information">
                <group>
                    <field name="instance_id" readonly="1" />
                </group>
                <group string="System Information">
                    <field
                        name="info_json"
                        widget="text"
                        readonly="1"
                        nolabel="1"
                        colspan="2"
                    />
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
