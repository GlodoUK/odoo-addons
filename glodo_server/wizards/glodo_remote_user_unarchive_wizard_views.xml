<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="glodo_remote_user_unarchive_wizard_view_form" model="ir.ui.view">
        <field name="name">glodo.remote.user.unarchive.wizard.view.form</field>
        <field name="model">glodo.remote.user.unarchive.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div
                    class="alert alert-info"
                    role="alert"
                >The user will be unarchived now and automatically re-archived on the date below</div>
                <group>
                    <field name="remote_user_id" readonly="1" />
                    <label for="duration" invisible="not is_reactivate_until" />
                    <div invisible="not is_reactivate_until">
                        <field name="duration" class="oe_inline" />
                        <span class="oe_inline ms-3">Hours</span>
                    </div>
                    <field
                        name="reactivate_until"
                        invisible="not is_reactivate_until"
                    />
                </group>
                <footer>
                    <button
                        string="Unarchive"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
