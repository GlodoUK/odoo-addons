<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_storage_category_form" model="ir.ui.view">
        <field name="name">stock.putaway.classification.storage.category.form</field>
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_form" />
        <field name="arch" type="xml">
            <field name="allow_new_product" position="after">
                <field
                    name="only_listed_package_types"
                    groups="stock.group_tracking_lot"
                />
            </field>
        </field>
    </record>
</odoo>
