<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_classification_list" model="ir.ui.view">
        <field name="name">product.classification.list</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="product_classification_search" model="ir.ui.view">
        <field name="name">product.classification.search</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="product_classification_action" model="ir.actions.act_window">
        <field name="name">Product Classifications</field>
        <field name="res_model">product.classification</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="product_classification_menu"
        action="product_classification_action"
        parent="stock.menu_product_in_config_stock"
        groups="stock.group_stock_manager"
        sequence="6"
    />
</odoo>
