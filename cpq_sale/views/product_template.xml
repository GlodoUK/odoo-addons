<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view_inherited" model="ir.ui.view">
        <field name="name">product.template.product.form</field>
        <field name="model">product.template</field>
        <field name="priority" eval="75" />
        <field name="inherit_id" ref="cpq.product_template_only_form_view_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='cpq_general_information']" position="inside">
                <group>
                    <group string="Quotation Description" name="cpq_description">
                        <field
                            name="cpq_description_sale_tmpl"
                            nolabel="1"
                            colspan="2"
                            placeholder="This note is added to sales orders and invoices."
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
