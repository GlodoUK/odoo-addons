<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="sale_order_form_quote" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list/field[@name='product_template_id']"
                position="before"
            >
                <field name="product_template_id_cpq_ok" column_invisible="1" />
                <field name="cpq_custom_value_ids" column_invisible="1">
                    <list>
                        <field name="ptav_id" />
                        <field name="custom_value" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
