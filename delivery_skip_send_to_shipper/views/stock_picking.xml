<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_wwuk_logistics" model="ir.ui.view">
        <field name="name">view_picking_form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="priority" eval="75" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="skip_send_to_shipper" />
            </xpath>
        </field>
    </record>
</odoo>
