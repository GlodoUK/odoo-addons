<odoo>

    <record
        id="timesheet_action_report_by_tick_type_categ"
        model="ir.actions.act_window"
    >
        <field name="name">Timesheets by Ticket Type</field>
        <field name="res_model">account.analytic.line</field>
        <field
            name="domain"
        >[('helpdesk_ticket_id', '!=', False), ('glo_ticket_type_id', '!=', False), ]</field>
        <field name="context">{'group_by':['glo_ticket_type_id']}</field>
        <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search" />
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No timesheets found
          </p>
        </field>
    </record>

    <record
        id="helpdesk_timesheet_report_report_by_tick_type_categ_pivot"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="5" />
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="hr_timesheet.view_hr_timesheet_line_pivot" />
        <field name="act_window_id" ref="timesheet_action_report_by_tick_type_categ" />
    </record>

    <record
        id="helpdesk_timesheet_report_report_by_tick_type_categ_graph"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="6" />
        <field name="view_mode">graph</field>
        <field name="view_id" ref="hr_timesheet.view_hr_timesheet_line_graph" />
        <field name="act_window_id" ref="timesheet_action_report_by_tick_type_categ" />
    </record>

    <record
        id="helpdesk_timesheet_report_report_by_tick_type_categ_tree"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="10" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hr_timesheet.hr_timesheet_line_tree" />
        <field name="act_window_id" ref="timesheet_action_report_by_tick_type_categ" />
    </record>

    <record
        id="helpdesk_timesheet_report_report_by_tick_type_categ_form"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="15" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_timesheet.hr_timesheet_line_form" />
        <field name="act_window_id" ref="timesheet_action_report_by_tick_type_categ" />
    </record>

    <record
        id="helpdesk_timesheet_report_report_by_tick_type_categ_kanban"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="20" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr_timesheet.view_kanban_account_analytic_line" />
        <field name="act_window_id" ref="timesheet_action_report_by_tick_type_categ" />
    </record>

    <menuitem
        id="helpdesk_timesheet_report_menu_timesheet_by_tick_type_categ"
        parent="helpdesk_timesheet_report.menu_custom_timesheets_reports_timesheet"
        action="timesheet_action_report_by_tick_type_categ"
        name="By Ticket Type"
        sequence="50"
    />

</odoo>
