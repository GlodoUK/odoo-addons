<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.list (stock_picking_state_duration)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="state_duration" widget="state_duration" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form (stock_picking_state_duration)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="date_done" position="after">
                <field
                    name="state_duration"
                    widget="state_duration"
                    invisible="not state_duration"
                />
            </field>
        </field>
    </record>
</odoo>
