<odoo>
    <template
        id="template_helpdesk_ticket_new_privacy"
        name="New Helpdesk Ticket (With Privacy)"
        inherit_id="helpdesk_portal_new_ticket.template_helpdesk_ticket_new"
    >
    <xpath expr="//form//button[@name='submit']/parent::div" position="before">
            <div class="mb-2">

                <div class="form-check">
                    <input
                        id="privacy"
                        class="privacy form-check-input"
                        name="privacy"
                        type="checkbox"
                        t-att-checked="'checked' if privacy else None"
                    />
                    <label for="privacy" class="form-check-label">
                        Only I can access this ticket
                    </label>
                </div>

            </div>
            <div id="add_followers" class="mb-2">
                <t t-if="allowed_partner_subscriber_ids">
                    <label for="category">Add Followers</label>
                    <div>
                        <select
                            id="partner_ids"
                            name="partner_ids[]"
                            class="glo_select2_selection js-states form-control"
                            multiple="multiple"
                        >
                            <option />
                            <t
                                t-foreach="allowed_partner_subscriber_ids"
                                t-as="allowed_partner_subscriber_id"
                            >
                                <option t-att-value="allowed_partner_subscriber_id.id">
                                    <t t-esc="allowed_partner_subscriber_id.name" />
                                </option>
                            </t>
                        </select>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
