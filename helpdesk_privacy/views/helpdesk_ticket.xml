<odoo>
    <record id="helpdesk_privacy_helpdesk_ticket_view_form_custom" model="ir.ui.view">
        <field name='name'>helpdesk_privacy_helpdesk_ticket_view_form_custom</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="is_private" />
                <field name="allowed_portal_partner_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>
</odoo>
