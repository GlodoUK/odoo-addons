<odoo>
    <record id="helpdesk_privacy_helpdesk_ticket_view_form_custom" model="ir.ui.view">
        <field name='name'>helpdesk_privacy_helpdesk_ticket_view_form_custom</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="is_private" widget="boolean_toggle" />
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <widget
                    name="web_ribbon"
                    title="Private"
                    bg_color="bg-warning"
                    attrs="{'invisible': [('is_private', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
