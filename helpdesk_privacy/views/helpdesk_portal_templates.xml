<odoo>
    <template
        id="helpdesk_privacy_tickets_followup"
        name="Helpdesk Tickets"
        inherit_id="helpdesk.tickets_followup"
    >
        <xpath expr="//div[@name='description']" position="before">
            <div class="row mb-4" t-if="ticket.is_private">
                <strong class="col-lg-2">Ticket Privacy</strong>
                <div class="col-lg-10">
                    <div class="row">
                        <div class="col-lg-10">
                            <span class="text-warning">
                                This ticket is marked as private
                                <i
                                    class="fa fa-info"
                                    title="Only the ticket creator, listed Customer and anyone in the Customer's organisation who is also added as a follower will be able to see/read the ticket."
                                />
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='description']" position="after">
<!--            <t t-if="not ticket.is_private">-->
                <div class="row mb-4">
                    <strong class="col-lg-2">Allowed users</strong>
                    <h4>
                        <t
                        t-foreach="allowed_portal_partner_ids"
                        t-as="allowed_portal_partner_id"
                    >
                            <span
                            class="badge badge-light"
                            t-esc="allowed_portal_partner_id.name"
                        />
                        </t>
                    </h4>
                </div>
                <div class="row mb-4">
                    <div class="col-lg-2">
                        <strong class="">Subscribers</strong><br />
                        <button
                        class="btn btn-sm btn-primary mb-2"
                        data-toggle="modal"
                        data-target="#subscriber_ids_modal"
                    >
                            Update subscribers
                        </button>
                    </div>
                    <div class="col">
                        <h4>
                            <t
                            t-foreach="active_portal_follower_ids"
                            t-as="active_portal_follower_id"
                        >
                                <span
                                class="badge badge-secondary"
                                t-esc="active_portal_follower_id.name"
                            />
                            </t>
                        </h4>
                    </div>
                    <div
                    class="modal fade"
                    id="subscriber_ids_modal"
                    tabindex="-1"
                    role="dialog"
                    aria-labelledby="follower_ids_label"
                    aria-hidden="true"
                >
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5
                                    class="modal-title"
                                    id="follower_ids_label"
                                >Update subscribers</h5>
                                    <button
                                    type="button"
                                    class="close"
                                    data-dismiss="modal"
                                    aria-label="Close"
                                >
                                        <b>X</b>
                                    </button>
                                </div>
                                <form
                                t-attf-action="/my/ticket/update_follower_ids/#{ticket_id}"
                                method="POST"
                            >
                                    <div class="modal-body">
                                        <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />
                                        <div class="row mb-4" name="followers">
                                            <strong class="col-lg-2">Followers</strong>
                                            <select
                                            id="follower_ids"
                                            name="follower_ids[]"
                                            class="glo_select2_selection js-states form-control"
                                            multiple="multiple"
                                        >
                                                <option />
                                                <t
                                                t-foreach="allowed_portal_partner_ids"
                                                t-as="allowed_portal_partner_id"
                                            >
                                                    <t
                                                    t-if="allowed_portal_partner_id in active_portal_follower_ids"
                                                >
                                                        <option
                                                        t-att-value="allowed_portal_partner_id.id"
                                                        selected="selected"
                                                    >
                                                            <t
                                                            t-esc="allowed_portal_partner_id.name"
                                                        />
                                                        </option>
                                                    </t>
                                                    <t t-else="">
                                                        <option
                                                        t-att-value="allowed_portal_partner_id.id"
                                                    >
                                                            <t
                                                            t-esc="allowed_portal_partner_id.name"
                                                        />
                                                        </option>
                                                    </t>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button
                                        class="btn btn-primary"
                                        type="submit"
                                    >Update subscribers</button>
                                        <button
                                        type="button"
                                        class="btn btn-secondary"
                                        data-dismiss="modal"
                                    >Close</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
<!--            </t>-->
        </xpath>
    </template>
</odoo>
