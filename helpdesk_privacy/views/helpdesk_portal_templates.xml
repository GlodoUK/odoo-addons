<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="tickets_followup" inherit_id="helpdesk.tickets_followup">
        <xpath expr="//t[@t-set='entries']/div" position="inside">
            <div class="mt-4">
                <div t-attf-class="col-12 col-md-12">
                    <h6>
                        <small class="text-muted">Privacy</small>
                    </h6>
                    <div t-if="ticket.is_private" class="flex-grow-1">
                        <div class="d-grid flex-sm-nowrap pt-2">
                            <a
                                role="button"
                                t-if="ticket.is_private"
                                t-attf-href="/helpdesk/ticket/privacy/#{ticket.id}"
                                class="btn btn-light pt-1"
                                title="This ticket is currently private and only followers can view it."
                            >
                        <i class="fa fa-lock me-1" /> Private
                    </a>

                            <small class="d-block text-muted">
                        Only followers can view this ticket
                    </small>
                        </div>
                    </div>

                    <div t-if="not ticket.is_private" class="flex-grow-1">
                        <div class="d-grid flex-sm-nowrap pt-2">
                            <a
                                role="button"
                                t-attf-href="/helpdesk/ticket/privacy/#{ticket.id}"
                                class="btn btn-light pt-1"
                                title="This ticket is currently public and all members of your company can view it."
                            >
                        <i class="fa fa-unlock me-1" /> Public
                    </a>

                            <small class="d-block text-muted">
                         All members of your company can view this ticket
                    </small>
                        </div>
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-grid flex-sm-nowrap mt-4">
                            <h6>
                                <small class="text-muted">Followers</small>
                            </h6>

                            <ul class="list-unstyled">
                                <li
                                    t-foreach="ticket.message_partner_ids"
                                    t-as="partner"
                                >
                                    <div
                                        class="d-flex flex-sm-nowrap flex-row align-items-center my-1"
                                    >
                                        <t t-call="portal.portal_my_contact">
                                            <t
                                                t-set="_contactAvatar"
                                                t-value="image_data_uri(partner.avatar_128)"
                                            />
                                            <t
                                                t-set="_contactName"
                                                t-value="partner.display_name"
                                            />
                                        </t>

                                        <form
                                            role="form"
                                            t-attf-action="/helpdesk/ticket/unfollow/#{ticket.id}"
                                            method="post"
                                            class="ms-auto"
                                        >
                                            <input
                                                t-att-value="request.csrf_token()"
                                                type="hidden"
                                                name="csrf_token"
                                            />

                                            <input
                                                t-att-value="partner.id"
                                                type="hidden"
                                                name="partner_id"
                                            />

                                            <button
                                                type="submit"
                                                class="btn btn-outline-danger fa fa-trash"
                                            />
                                        </form>
                                    </div>
                                </li>
                            </ul>

                            <t
                                t-set="privacy_possible_followers"
                                t-value="ticket._privacy_possible_followers()"
                            />

                            <button
                                t-if="privacy_possible_followers"
                                class="btn btn-light pt-1"
                                data-bs-toggle="modal"
                                data-bs-target="#helpdesk_ticket_followers_modal"
                            >
                        <i class="fa fa-plus" aria-hidden="true" /> Add Followers
                    </button>

                            <div
                                class="modal"
                                id="helpdesk_ticket_followers_modal"
                                tabindex="-1"
                                role="dialog"
                            >
                                <div
                                    class="modal-dialog modal-dialog-scrollable mt-5"
                                    role="document"
                                >
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5
                                                class="modal-title"
                                            >Add new followers</h5>
                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close"
                                            />
                                        </div>
                                        <div
                                            class="modal-body helpdesk_privacy_followers"
                                        >
                                            <form
                                                t-attf-action="/helpdesk/ticket/follow/#{ticket.id}"
                                                method="post"
                                                role="form"
                                            >
                                                <input
                                                    type="hidden"
                                                    t-att-value="request.csrf_token()"
                                                    name="csrf_token"
                                                />
                                                <div class="flex-column">
                                                    <t
                                                        t-if="privacy_possible_followers"
                                                        t-foreach="privacy_possible_followers"
                                                        t-as="partner"
                                                    >
                                                        <div class="form-check mb-1">
                                                            <input
                                                                type="checkbox"
                                                                name="partner_ids"
                                                                class="form-check-input"
                                                                t-attf-id="partner_#{partner.id}"
                                                                t-att-value="partner.id"
                                                            />
                                                            <label
                                                                class="form-check-label fw-normal"
                                                                t-attf-for="partner_#{partner.id}"
                                                                t-field="partner.name"
                                                            />
                                                        </div>
                                                    </t>
                                                </div>
                                                <div class="modal-footer">
                                                    <button
                                                        type="submit"
                                                        class="btn btn-danger"
                                                    >
                                                Add
                                            </button>
                                                    <button
                                                        type="button"
                                                        class="btn btn-light"
                                                        data-bs-dismiss="modal"
                                                    >
                                                Discard
                                            </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
