<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="tickets_followup" inherit_id="helpdesk.tickets_followup">
        <xpath expr="//t[@t-set='entries']/div" position="inside">
            <div class="flex-grow-1 my-2">
                <div class="d-flex flex-sm-nowrap align-items-center">
                    <strong class="me-2">Privacy</strong>

                    <a
                        role="button"
                        t-if="ticket.is_private"
                        t-attf-href="/helpdesk/ticket/privacy/#{ticket.id}"
                        class="btn btn-light"
                        title="This ticket is currently private and only followers can view it."
                    >
                        <i class="fa fa-lock me-1" /> Private
                    </a>

                    <a
                        role="button"
                        t-else=""
                        t-attf-href="/helpdesk/ticket/privacy/#{ticket.id}"
                        class="btn btn-light"
                        title="This ticket is currently public and all members of your company can view it."
                    >
                        <i class="fa fa-unlock me-1" /> Public
                    </a>
                </div>

                <span t-if="ticket.is_private" class="d-block text-muted">
                    Only followers can view this ticket
                </span>

                <span t-else="" class="d-block text-muted">
                    All members of your company can view this ticket
                </span>

                <strong>
                    Followers
                </strong>

                <ul class="list-unstyled">
                    <li t-foreach="ticket.message_partner_ids" t-as="partner">
                        <div
                            class="d-flex flex-sm-nowrap flex-row align-items-center my-1"
                        >
                            <img
                                class="o-mail-Composer-avatar o_avatar rounded me-1"
                                alt="Avatar of user"
                                t-att-src="image_data_uri(partner.avatar_1024)"
                            />

                            <div
                                t-out="partner"
                                t-options='{"widget": "contact", "fields": ["name"]}'
                                class="me-1"
                            />

                            <form
                                role="form"
                                t-attf-action="/helpdesk/ticket/unfollow/#{ticket.id}"
                                method="post"
                                class="ms-auto"
                            >
                                <input
                                    t-att-value="request.csrf_token()"
                                    type="hidden"
                                    name="csrf_token"
                                />

                                <input
                                    t-att-value="partner.id"
                                    type="hidden"
                                    name="partner_id"
                                />

                                <button
                                    type="submit"
                                    class="btn btn-outline-danger fa fa-trash"
                                />
                            </form>
                        </div>
                    </li>
                </ul>

                <button
                    class="btn btn-light ms-auto"
                    data-bs-toggle="modal"
                    data-bs-target="#helpdesk_ticket_followers_modal"
                >
                    <i class="fa fa-plus" aria-hidden="true" /> Add more
                </button>

                <div
                    class="modal"
                    tabindex="-1"
                    role="dialog"
                    id="helpdesk_ticket_followers_modal"
                >
                    <div class="modal-dialog mt-5" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Add new followers</h5>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                />
                            </div>
                            <form
                                t-attf-action="/helpdesk/ticket/follow/#{ticket.id}"
                                method="post"
                                role="form"
                            >
                                <input
                                    t-att-value="request.csrf_token()"
                                    type="hidden"
                                    name="csrf_token"
                                />
                                <div class="modal-body helpdesk_privacy_followers">
                                    <div class="flex-column">
                                        <t
                                            t-foreach="ticket._privacy_possible_followers()"
                                            t-as="partner"
                                        >
                                            <div class="form-check mb-1">
                                                <input
                                                    type="checkbox"
                                                    name="partner_ids"
                                                    class="form-check-input"
                                                    t-attf-id="partner_#{partner.id}"
                                                    t-att-value="partner.id"
                                                />
                                                <label
                                                    class="form-check-label fw-normal"
                                                    t-attf-for="partner_#{partner.id}"
                                                    t-field="partner.name"
                                                />
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-danger">
                                        Add
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-light"
                                        data-bs-dismiss="modal"
                                    >
                                        Discard
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
