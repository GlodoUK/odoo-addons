<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_inventory_adjustment_reason_view_list" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.reason.list</field>
        <field name="model">stock.inventory.adjustment.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="stock_inventory_adjustment_reason_action" model="ir.actions.act_window">
        <field name="name">Inventory Adjustment Reasons</field>
        <field name="res_model">stock.inventory.adjustment.reason</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="stock_inventory_adjustment_reason_menu"
        name="Inventory Adjustment Reasons"
        parent="stock.menu_warehouse_config"
        action="stock_inventory_adjustment_reason_action"
        sequence="90"
    />
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inventory.reason</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="production_lot_info" position="inside">
                <setting
                    id="use_fixed_inventory_adjustment_reason"
                    help="Choose the reason for inventory adjustments from a predefined list"
                    company_dependent="1"
                >
                    <field name="use_fixed_inventory_adjustment_reason" />
                    <div
                        class="mt8"
                        invisible="not use_fixed_inventory_adjustment_reason"
                    >
                        <button
                            name="%(stock_inventory_adjustment_reason_action)d"
                            type="action"
                            icon="oi-arrow-right"
                            string="Inventory Adjustment Reasons"
                            class="btn-link"
                        />
                    </div>
                </setting>
                <setting
                    id="require_inventory_adjustment_reason"
                    help="Make the reason mandatory when applying an inventory adjustment"
                    company_dependent="1"
                >
                    <field name="require_inventory_adjustment_reason" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
