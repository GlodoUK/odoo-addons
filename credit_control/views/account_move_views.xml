<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_form_view" model="ir.ui.view">
        <field name="name">account_move_form_view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority" eval="75" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="skip_credit_control_rules" />
            </xpath>
        </field>
    </record>
</odoo>
