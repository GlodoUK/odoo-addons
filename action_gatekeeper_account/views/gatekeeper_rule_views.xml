<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="gatekeeper_rule_form" model="ir.ui.view">
        <field name="name">gatekeeper_rule_form</field>
        <field name="model">gatekeeper.rule</field>
        <field name="inherit_id" ref="action_gatekeeper.gatekeeper_rule_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='target_model']" position="after">
                <field
                    name="target_move_type"
                    invisible="target_model != 'account.move'"
                    required="target_model=='account.move'"
                />
            </xpath>
        </field>
    </record>
</odoo>
