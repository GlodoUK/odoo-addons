<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_move_form_gatekeeper" model="ir.ui.view">
        <field name="name">account.move.form.gatekeeper</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="after">
                <widget
                    name="web_ribbon"
                    title="Sale Held"
                    bg_color="text-bg-danger"
                    invisible="not gatekeeper_hold"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Gatekeeper" name="gatekeeper">
                    <field
                        name="gatekeeper_rule_lines"
                        widget="one2many_list"
                        nolabel="1"
                    />
                </page>
            </xpath>
        </field>
    </record>

    <record id="gatekeeper_rule_action_window" model="ir.actions.act_window">
        <field name="name">Gatekeeper Rules</field>
        <field name="res_model">gatekeeper.rule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('target_model', '=', 'account.move')]</field>
    </record>

    <menuitem
        id="gatekeeper_rule_menu_account"
        name="Gatekeeper Rules"
        action="gatekeeper_rule_action_window"
        parent="account.menu_finance_configuration"
    />
</odoo>
