<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_form_gate" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <widget
                    name="web_ribbon"
                    title="Approval blocked"
                    bg_color="text-bg-danger"
                    invisible="gate_state != 'blocked'"
                />
                <widget
                    name="web_ribbon"
                    title="Flagged"
                    bg_color="text-bg-warning"
                    invisible="gate_state != 'flagged'"
                />
                <field name="gate_state" invisible="1" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="gate" string="Approvals" invisible="not gate_hold_ids">
                    <field name="gate_hold_ids" readonly="1">
                        <list>
                            <field name="rule_id" />
                            <field name="tier" />
                            <field name="clearance_count" string="Clearances" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-warning="state == 'pending'"
                                decoration-muted="state == 'waiting'"
                                decoration-success="state == 'cleared'"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
