<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="name">res.partner.simplified.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form" />
        <field name="arch" type="xml">
            <field name="function" position="after">
                <label for="work_number" />
                <div>
                    <field name="work_number" widget="phone" class="oe_inline" />
                    <field name="work_number_ext" class="oe_inline" />
                </div>
            </field>
        </field>
    </record>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <field name="function" position="after">
                <label for="work_number" />
                <div class="oe_inline">
                    <field
                        name="work_number"
                        widget="phone"
                        placeholder="Work Number..."
                        class="w-75"
                    />
                    <field name="work_number_ext" placeholder="Ext." class="w-25" />
                </div>
            </field>
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='phone']//parent::div"
                position="after"
            >
                <div class="d-flex align-items-baseline">
                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Work Phone" />
                    <field
                        name="work_number"
                        widget="phone"
                        placeholder="Work Number..."
                    />
                    <field
                        name="work_number_ext"
                        placeholder="Work Ext..."
                        class="ms-1"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
