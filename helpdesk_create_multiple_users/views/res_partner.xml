<odoo>
    <record id="helpdesk_create_multiple_users_view_partner_form" model="ir.ui.view">
        <field name="name">helpdesk_create_multiple_users_view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']/.." position="before">
                <header attrs="{'invisible': [('company_type', '!=', 'company')]}">
                    <button
                        class="btn-primary"
                        name="add_portal_users_to_company"
                        type="object"
                        string="Add users"
                        data-hotkey="l"
                        title="Adds portal users to company"
                        icon="fa-child"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
