<odoo>
    <record id="res_config_settings_view_teams_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.teams.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='unsplash']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="teams_webhook">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane" id="teams_webhook_settings">
                        <div class="content-group mt16">
                            <label
                                for="glo_teams_webhook_url"
                                string="Microsoft Teams Webhook"
                                class="o_form_label"
                            />
                            <a
                                href="https://docs.microsoft.com/en-us/microsoftteams/platform/webhooks-and-connectors/how-to/add-incoming-webhook"
                                title="How to create webhook link?"
                                class="o_doc_link"
                                target="_blank"
                            />
                            <field name="glo_teams_webhook_url" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
