<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_form_view" model="ir.ui.view">
        <field name="name">product_fsc.res_partner_form_view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="fsc" string="FSC">
                    <group>
                        <group>
                            <field name="fsc_certificate_code" />
                            <field name="fsc_license_code" />
                            <field name="fsc_certificate_expiry" />
                        </group>
                        <group>
                            <field
                                name="fsc_certificate"
                                filename="fsc_certificate_filename"
                            />
                            <field name="fsc_certificate_filename" invisible="1" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
