<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="fsc_claim_block">
        <div t-if="fsc_lines" class="mt-4" name="fsc_claim_block">
            <table class="table o_main_table table-borderless" name="fsc_claim_table">
                <thead>
                    <tr>
                        <th name="th_fsc_product" class="text-start">
                            <span>Product</span>
                        </th>
                        <th name="th_fsc_claim" class="text-end">
                            <span>FSC® Claim</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="fsc_lines" t-as="fsc_line">
                        <td name="td_fsc_product">
                            <span
                                t-out="fsc_line.product_id.display_name"
                            >Customizable Desk</span>
                        </td>
                        <td name="td_fsc_claim" class="text-end">
                            <span t-out="fsc_line.fsc_label">FSC Mix 70%</span>
                        </td>
                    </tr>
                </tbody>
            </table>
            <!--
                FSC-STD-40-004 requires the certificate code alongside the
                claims.
            -->
            <p name="fsc_certificate_code">
                FSC® Chain of Custody certificate:
                <span
                t-if="company.fsc_certificate_code"
                class="fw-bold"
                t-field="company.fsc_certificate_code"
            >XXX-COC-000000</span>
                <span t-else="" class="fw-bold text-danger">
                    Not configured - set the FSC Certificate Code on the company
                </span>
            </p>
        </div>
    </template>
</odoo>
