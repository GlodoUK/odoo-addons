<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="rss_feed_company_rule" model="ir.rule">
        <field name="name">RSS Feed: multi-company</field>
        <field name="model_id" ref="model_rss_feed" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rss_item_company_rule" model="ir.rule">
        <field name="name">RSS Item: multi-company</field>
        <field name="model_id" ref="model_rss_item" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rss_feed_filter_company_rule" model="ir.rule">
        <field name="name">RSS Feed Filter: multi-company</field>
        <field name="model_id" ref="model_rss_feed_filter" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
