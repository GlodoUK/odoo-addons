<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rule_autopilot_purchase_backend_company" model="ir.rule">
        <field name="name">Purchase EDI Backend: multi-company</field>
        <field name="model_id" ref="model_autopilot_purchase_backend" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_purchase_order_company" model="ir.rule">
        <field name="name">Purchase EDI Order Binding: multi-company</field>
        <field name="model_id" ref="model_autopilot_purchase_order" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_autopilot_purchase_order_file_company" model="ir.rule">
        <field name="name">Purchase EDI Order File: multi-company</field>
        <field name="model_id" ref="model_autopilot_purchase_order_file" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Global, so they add to the company rules for everyone. Bindings and
         files follow their backend's access groups. -->
    <record id="rule_autopilot_purchase_backend_access" model="ir.rule">
        <field name="name">Purchase EDI Backend: access groups</field>
        <field name="model_id" ref="model_autopilot_purchase_backend" />
        <field
            name="domain_force"
        >['|', ('restrict_group_ids', '=', False), ('restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_purchase_order_access" model="ir.rule">
        <field name="name">Purchase EDI Order Binding: access groups</field>
        <field name="model_id" ref="model_autopilot_purchase_order" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="rule_autopilot_purchase_order_file_access" model="ir.rule">
        <field name="name">Purchase EDI Order File: access groups</field>
        <field name="model_id" ref="model_autopilot_purchase_order_file" />
        <field
            name="domain_force"
        >['|', ('backend_id.restrict_group_ids', '=', False), ('backend_id.restrict_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>
</odoo>
