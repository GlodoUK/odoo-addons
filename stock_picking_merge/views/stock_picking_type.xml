<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_type_form_merge" model="ir.ui.view">
        <field name="name">stock.picking.type.form.merge</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="allow_merge" string="Allow Merge" />
            </xpath>
        </field>
    </record>
</odoo>
