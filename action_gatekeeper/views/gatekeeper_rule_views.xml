<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="gatekeeper_rule_form" model="ir.ui.view">
        <field name="name">gatekeeper_rule_form</field>
        <field name="model">gatekeeper.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                        <field name="name" string="Rule Name" />
                        <field name="target_model" string="Target records of type..." />
                        <p
                            invisible="target_model"
                            colspan="2"
                        >If no Target Models are available, you need to install an addon module to add support.</p>
                    </group>
                    <group string="Rule Logic" invisible="target_model == False">
                        <field
                            name="target_domain"
                            widget="domain"
                            options="{'model': 'target_model'}"
                            string="Target records where..."
                        />
                        <field
                            name="trigger"
                            domain="['|', ('model_name', '=', target_model), ('model_name', 'in', [False, ''])]"
                            options="{'no_create': True}"
                        />
                        <field name="rule" />
                        <field
                            name="record_domain"
                            widget="domain"
                            options="{'model': 'target_model'}"
                            invisible="rule != 'record_domain'"
                            string="Only when the record matches this filter..."
                        />
                        <field
                            name="code"
                            widget="code"
                            options="{'mode': 'python'}"
                            invisible="rule != 'code'"
                        />
                        <field name="action" />
                        <field
                            name="block_message"
                            string="Block Message"
                            placeholder="Optional message to display when blocking a record."
                            invisible="action != 'block'"
                        />
                    </group>

                    <group
                        string="Release Permissions"
                        invisible="target_model == False"
                    >
                        <p
                            colspan="2"
                        >When triggered, which users or groups can release this rule?</p>
                        <div
                            class="alert alert-danger"
                            role="alert"
                            colspan="2"
                            invisible="enough_users_can_release"
                        >
                            <strong
                        >Note:</strong> Not enough users can release this rule to satisfy the Release Count Required!</div>
                        <field
                            name="release_users"
                            widget="many2many_tags"
                            string="Release Users"
                        />
                        <field
                            name="release_groups"
                            widget="many2many_tags"
                            string="Release Groups"
                        />
                        <field
                            name="release_count_required"
                            string="Release Count Required"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gatekeeper_rule_list" model="ir.ui.view">
        <field name="name">gatekeeper_rule_list</field>
        <field name="model">gatekeeper.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="target_model" />
            </list>
        </field>
    </record>

    <record id="gatekeeper_rule_search" model="ir.ui.view">
        <field name="name">gatekeeper_rule_search</field>
        <field name="model">gatekeeper.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="target_model" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="target_model_group"
                        string="Target Model"
                        context="{'group_by': 'target_model'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="gatekeeper_rule_action_window" model="ir.actions.act_window">
        <field name="name">Gatekeeper Rules</field>
        <field name="res_model">gatekeeper.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="gatekeeper_rule_menu"
        name="Gatekeeper Rules"
        action="gatekeeper_rule_action_window"
        parent="base.menu_automation"
    />
</odoo>
