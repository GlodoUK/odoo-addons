<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_sla_report_analysis_view_search" model="ir.ui.view">
        <field name="name">helpdesk.sla.report.analysis.search</field>
        <field name="model">helpdesk.sla.report.analysis</field>
        <field
            name="inherit_id"
            ref="helpdesk.helpdesk_sla_report_analysis_view_search"
        />
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="ticket_categ_id" />
            </field>

            <filter name="stage" position="after">
                <filter
                    string="Category"
                    name="category"
                    context="{'group_by':'ticket_categ_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
