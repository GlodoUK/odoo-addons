<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="helpdesk_sla_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_view_form"/>
        <field name="arch" type="xml">
            <field name="priority" position="after">
                <field name="ticket_categ_ids" options="{'no_open': True, 'no_create_edit': True}" widget="many2many_tags"/>
            </field>

            <field name="ticket_type_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="helpdesk_sla_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.sla.tree</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_view_tree"/>
        <field name="arch" type="xml">
            <field name="priority" position="after">
                <field name="ticket_categ_ids" options="{'no_open': True, 'no_create_edit': True}" optional="show" widget="many2many_tags"/>
            </field>

            <field name="ticket_type_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="helpdesk_sla_view_search" model="ir.ui.view">
        <field name="name">helpdesk.sla.search</field>
        <field name="model">helpdesk.sla</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_sla_view_search"/>
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="ticket_categ_ids"/>
            </field>

            <field name="ticket_type_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
