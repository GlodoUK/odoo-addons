<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="template_helpdesk_ticket_new" name="New Ticket">
        <t t-call="portal.portal_layout">
            <t t-set="wrapwrap_classes" t-value="'o_portal_bg_dark'" />

            <form id="helpdesk_ticket_new" method="post">
                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"
                />

                <div class="my-3">
                    <label class="form-label">
                        Team
                    </label>

                    <t t-foreach="team_ids" t-as="team_id">
                        <div class="form-check">
                            <input
                                name="team"
                                t-attf-id="team_id_{{ team_id.id }}"
                                t-attf-value="{{team_id.id}}"
                                type="radio"
                                class="form-check-input"
                                required="required"
                            />
                            <label
                                t-attf-for="team_id_{{ team_id.id }}"
                                class="form-check-label"
                                t-esc="team_id.display_name"
                            />
                        </div>
                    </t>
                </div>

                <div class="my-3">
                    <label class="form-label" for="subject">
                        Subject
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="subject"
                        name="subject"
                        placeholder="Subject"
                        aria-describedby="subjectHelpBlock"
                        required="required"
                    />

                    <span class="form-text text-muted" id="subjectHelpBlock">
                        A brief reference
                    </span>
                </div>

                <div class="my-3">
                    <label class="form-label" for="description">
                        Description
                    </label>

                    <textarea
                        class="form-control"
                        id="description"
                        name="description"
                        cols="40"
                        rows="10"
                        aria-describedby="descriptionHelpBlock"
                        required="required"
                    />

                    <span class="form-text text-muted" id="descriptionHelpBlock">
                        A description of your issue, please include as much as detail as possible
                    </span>
                </div>

                <div class="my-3" id="div_priority">
                    <label>
                        Priority
                    </label>

                    <t t-foreach="priorities" t-as="priority">
                        <div class="form-check">
                            <input
                                type="radio"
                                class="form-check-input"
                                t-attf-id="priority_{{ priority[0] }}"
                                name="priority"
                                t-attf-value="{{priority[0]}}"
                                t-att-checked="'checked' if priority[0] == default_priority else False"
                                required="required"
                            />

                            <label
                                class="form-check-label"
                                t-out="priority[1]"
                                t-attf-for="priority_{{ priority[0] }}"
                            />
                        </div>
                    </t>
                </div>

                <div id="div_ticket_categ_id"/>

                <div class="my-3">
                    <button
                        type="submit"
                        class="btn btn-primary"
                        name="submit"
                    >Submit</button>
                </div>
            </form>
        </t>
    </template>
</odoo>

