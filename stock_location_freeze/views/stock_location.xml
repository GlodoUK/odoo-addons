<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_location_form" model="ir.ui.view">
        <field name="name">view_location_form</field>
        <field name="model">stock.location</field>
        <field name="priority" eval="75" />
        <field name="inherit_id" ref="stock.view_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_freeze"
                        type="object"
                        icon="fa-lock"
                        invisible="frozen"
                        string="Freeze"
                    />
                    <button
                        name="action_unfreeze"
                        type="object"
                        icon="fa-unlock"
                        invisible="not frozen"
                        string="Unfreeze"
                    />
                </header>
            </xpath>
            <xpath expr="//group[@name='additional_info']" position="after">
                <group string="Freeze Information" name="freeze_info">
                    <field name="frozen" />
                    <field name="frozen_parent_path" />
                    <field name="frozen_by_ancestor" />
                    <field name="freeze_reason_id" invisible="not frozen" />
                    <field name="freeze_uid" invisible="not frozen" />
                    <field name="freeze_date" invisible="not frozen" />
                    <field name="unfreeze_uid" invisible="frozen" />
                    <field name="unfreeze_date" invisible="frozen" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
