<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.sale_mrp_phantom_explode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_template_id']"
                position="after"
            >
                <field name="product_is_kit" column_invisible="1" />
                <button
                    name="action_sale_mrp_phantom_explode"
                    type="object"
                    icon="fa-bomb"
                    title="Explode kit into components"
                    confirm="Replace this kit with its component lines? This cannot be undone."
                    invisible="not product_is_kit or state not in ('draft', 'sent')"
                />
            </xpath>
        </field>
    </record>
</odoo>
